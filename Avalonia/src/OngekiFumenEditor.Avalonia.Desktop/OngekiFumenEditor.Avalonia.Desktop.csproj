<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
    One for Windows with net8.0-windows TFM, one for MacOS with net8.0-macos and one with net8.0 TFM for Linux.-->
        <TargetFramework Condition=" '$(PublishAot)' == 'true' Or '$(PublishProfile)' == 'win-x64-aot' ">net10.0</TargetFramework>
        <TargetFramework Condition=" '$(PublishAot)' != 'true' And '$(PublishProfile)' != 'win-x64-aot' ">net10.0-windows10.0.19041.0</TargetFramework>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ImplicitUsings>enable</ImplicitUsings>
        <InjectioDuplicateStrategy>Append</InjectioDuplicateStrategy>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="InjectioDuplicateStrategy" />
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OngekiFumenEditor.Avalonia.Desktop.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(PublishAot)' == 'true' Or '$(PublishProfile)' == 'win-x64-aot' ">
        <!-- NAudio 3 WASAPI is Native-AOT compatible; its ASIO backend still requires runtime code generation. -->
        <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AssetsTools.NET" />
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="XamlMcp.Avalonia" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug"/>
        <PackageReference Include="NAudio.Wasapi"/>
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="Svg.Skia" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="NAudio.Asio"
                          Condition=" '$(PublishAot)' != 'true' And '$(PublishProfile)' != 'win-x64-aot' "/>
        <PackageReference Include="NAudio.WinMM"
                          Condition=" '$(PublishAot)' != 'true' And '$(PublishProfile)' != 'win-x64-aot' "/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="TexturePlugin">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\JacketGenerator\TexturePlugin.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\..\OngekiFumenEditor\Resources\MusicSource.xml"
                          Link="Resources\MusicSource.xml"
                          LogicalName="OngekiFumenEditor.Avalonia.Desktop.Resources.MusicSource.xml" />
        <Content Include="..\..\..\OngekiFumenEditor\Resources\ui_jacket_0666"
                 Link="ui_jacket_0666"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\..\..\OngekiFumenEditor\Dependencies\JacketGenerator\TexturePlugin.dll"
                 Condition=" '$(PublishAot)' == 'true' Or '$(PublishProfile)' == 'win-x64-aot' "
                 Link="TexturePlugin.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="Always" />
        <Content Include="..\..\..\OngekiFumenEditor\costura-win-x64\TexToolWrap.dll"
                 Link="TexToolWrap.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\..\..\OngekiFumenEditor\costura-win-x64\crnlib.dll"
                 Link="crnlib.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\..\..\OngekiFumenEditor\costura-win-x64\PVRTexLib.dll"
                 Link="PVRTexLib.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\..\..\OngekiFumenEditor\costura-win-x64\ispc_texcomp.dll"
                 Link="ispc_texcomp.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\..\..\OngekiFumenEditor\costura-win-x64\SoundTouch.dll"
                 Link="SoundTouch.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Dependencies\AcbGeneratorFuck\src\AcbGeneratorFuck\AcbGeneratorFuck.csproj"/>
        <ProjectReference Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia\Gekimini.Avalonia.csproj"/>

        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="true" Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\Injectio\src\Injectio.Attributes\Injectio.Attributes.csproj"/>
        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="false" Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\Injectio\src\Injectio.Generators\Injectio.Generators.csproj"/>
        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="true" Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia.Attributes\Gekimini.Avalonia.Attributes.csproj"/>
        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="false" Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia.Generator\Gekimini.Avalonia.Generator.csproj"/>
        <ProjectReference Include="..\OngekiFumenEditor.Avalonia\OngekiFumenEditor.Avalonia.csproj"/>
    </ItemGroup>
</Project>
