<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- NativeAOT flavor: one self-contained EXE; native dependencies are embedded as
         zip/hash resources and extracted at startup (see DesktopPublish.targets). -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- Native PDBs remain under bin/Release; the redistributable contains only the EXE. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
</Project>
