<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- JIT flavor: the SDK single-file bundler packs the managed assemblies into the apphost and
         extracts the native libraries (including the framework's) on first start. -->
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Measured on win-x64 (6 runs, extraction cache cleared): enabling compression grows peak
         working set 211 -> 505 MiB and warm start 0.68 -> 1.26 s while saving 247 MiB on disk
         (402 -> 155 MiB). Distribution size is unchanged (149.0 vs 147.4 MiB zipped), so keep it off. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Symbols and documentation stay in build output; the redistributable contains only the EXE. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
</Project>
