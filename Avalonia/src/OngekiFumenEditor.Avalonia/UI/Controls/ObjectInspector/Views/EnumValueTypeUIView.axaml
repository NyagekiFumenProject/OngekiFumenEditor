<UserControl
    x:Class="OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.Views.EnumValueTypeUIView"
    x:CompileBindings="True"
    x:DataType="viewModels:EnumValueTypeUIViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Grid Name="MainPanel" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Margin="0,0,15,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
            Text="{Binding PropertyInfo.DisplayPropertyName}"
            ToolTip.Tip="{Binding PropertyInfo.DisplayPropertyTipText}">
        </TextBlock>
        <ComboBox
            Grid.Column="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            ItemsSource="{Binding EnumValues}"
            SelectedValue="{Binding Value}">
        </ComboBox>
    </Grid>
</UserControl>
