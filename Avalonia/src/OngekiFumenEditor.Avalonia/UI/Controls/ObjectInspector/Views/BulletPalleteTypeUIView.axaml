<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.Views.BulletPalleteTypeUIView"
    x:DataType="viewModels:BulletPalleteTypeUIViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.ViewModels"
    d:Background="White"
    d:Height="75"
    d:Width="200"
    mc:Ignorable="d" xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls">
    <controls:GroupBox
        Margin="5,0,5,0"
        BorderBrush="DarkGray"
        Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
        Header="{Binding PropertyInfo.DisplayPropertyName}"
        ToolTip.Tip="{Binding PropertyInfo.DisplayPropertyTipText}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                    Text="StrID">
                </TextBlock>
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderBrush="DarkGray"
                    Text="{Binding StrId}">
                </TextBox>
            </Grid>
            <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Background="LightGray"
                    Command="{Binding SetNullCommand}">
                    Set Null
                </Button>
                <Button
                    Grid.Column="2"
                    Background="LightGray"
                    Command="{Binding OpenSelectListCommand}">
                    更换模板
                </Button>
            </Grid>
        </StackPanel>
    </controls:GroupBox>
</gekViews:ViewBase>



