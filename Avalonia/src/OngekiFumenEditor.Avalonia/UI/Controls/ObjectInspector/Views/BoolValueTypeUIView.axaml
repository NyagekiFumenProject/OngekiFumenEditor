<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.Views.BoolValueTypeUIView"
    x:DataType="viewModels:BoolValueTypeUIViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.ViewModels"
    mc:Ignorable="d">
    <Grid Name="MainPanel" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Margin="0,0,15,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
            Text="{Binding PropertyInfo.DisplayPropertyName}"
            ToolTip.Tip="{Binding PropertyInfo.DisplayPropertyTipText}">
        </TextBlock>
        <CheckBox
            Grid.Column="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderBrush="DarkGray"
            IsChecked="{Binding PropertyInfo.ProxyValue}">
        </CheckBox>
    </Grid>
</gekViews:ViewBase>
