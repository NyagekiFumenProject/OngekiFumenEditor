<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.Views.ColorIdEnumTypeUIView"
    x:DataType="vm:ColorIdEnumTypeUIViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:objects="clr-namespace:OngekiFumenEditor.Avalonia.Base.OngekiObjects"
    xmlns:valueconverters="clr-namespace:OngekiFumenEditor.Avalonia.UI.ValueConverters"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.ViewModels"
    mc:Ignorable="d">
    <gekViews:ViewBase.Resources>
        <valueconverters:ContrastingColorsConverter x:Key="ContrastingColorsConverter" />
    </gekViews:ViewBase.Resources>
    <Grid Name="MainPanel" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Margin="0,0,15,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
            Text="{Binding PropertyInfo.DisplayPropertyName}"
            ToolTip.Tip="{Binding PropertyInfo.DisplayPropertyTipText}">
        </TextBlock>
        <ComboBox
            Grid.Column="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            ItemsSource="{Binding EnumValues}"
            SelectedValue="{Binding PropertyInfo.ProxyValue}">
            <ComboBox.Styles>
                <Style x:DataType="objects:ColorId" Selector="ComboBoxItem">
                    <Setter Property="Foreground">
                        <Setter.Value>
                            <SolidColorBrush Color="{Binding Color, Converter={StaticResource ContrastingColorsConverter}}" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{Binding Color}" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </ComboBox.Styles>
        </ComboBox>
    </Grid>
</gekViews:ViewBase>
