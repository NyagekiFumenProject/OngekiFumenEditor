<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.Views.FileInfoTypeUIView"
    x:DataType="viewModels:FileInfoTypeUIViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:gemini="http://schemas.timjones.io/gemini"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.Views"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewModels:FileInfoTypeUIViewModel}"
    mc:Ignorable="d" xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls">
    <controls:GroupBox
        Margin="5,0,5,0"
        BorderBrush="DarkGray"
        Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
        Header="{Binding PropertyInfo.DisplayPropertyName}"
        ToolTip.Tip="{Binding PropertyInfo.DisplayPropertyTipText}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Button
                Grid.Row="0"
                Grid.Column="1"
                Padding="10,2,10,2"
                Command="{Binding SelectFileCommand}"
                Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                Content="{markup:Translate {x:Static languages:Lang+B.SelectFile}}" />
            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                Text="{Binding File.FileName}"
                ToolTip.Tip="{Binding File.FullPath}">
            </TextBlock>
        </Grid>
    </controls:GroupBox>
</gekViews:ViewBase>



