<views:WindowViewBase
    x:Class="OngekiFumenEditor.Avalonia.UI.Dialogs.Views.CommonColorPickerView"
    x:CompileBindings="True"
    x:DataType="vm:CommonColorPickerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.UI.Dialogs.ViewModels"
    Title="{CompiledBinding Title}"
    Width="300"
    Height="450"
    Background="{DynamicResource EditorWindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance Type=vm:CommonColorPickerViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <Grid>
        <!-- Xceed StandardColorPicker 在 Avalonia 下不可用，先用固定色板占位：点击按钮设置 CurrentColor -->
        <StackPanel Margin="10">
            <Border
                Height="40"
                Background="{CompiledBinding CurrentColor}"
                BorderBrush="Gray"
                BorderThickness="1" />
            <WrapPanel Margin="0,10,0,0">
                <Button Width="32" Height="32" Margin="2" Background="#FFFFFFFF" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FFFFFFFF" />
                <Button Width="32" Height="32" Margin="2" Background="#FF000000" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FF000000" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFF0000" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FFFF0000" />
                <Button Width="32" Height="32" Margin="2" Background="#FF00FF00" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FF00FF00" />
                <Button Width="32" Height="32" Margin="2" Background="#FF0000FF" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FF0000FF" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFFFF00" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FFFFFF00" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFF00FF" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FFFF00FF" />
                <Button Width="32" Height="32" Margin="2" Background="#FF00FFFF" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FF00FFFF" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFFA500" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FFFFA500" />
                <Button Width="32" Height="32" Margin="2" Background="#FF800080" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FF800080" />
                <Button Width="32" Height="32" Margin="2" Background="#FFA52A2A" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FFA52A2A" />
                <Button Width="32" Height="32" Margin="2" Background="#FF808080" Command="{CompiledBinding SelectColorCommand}" CommandParameter="#FF808080" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</views:WindowViewBase>
