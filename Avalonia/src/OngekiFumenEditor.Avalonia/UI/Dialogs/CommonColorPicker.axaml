<Window
    x:Class="OngekiFumenEditor.Avalonia.UI.Dialogs.CommonColorPicker"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.UI.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CommonColorPicker"
    Width="300"
    Height="450"
    Background="{DynamicResource EnvironmentWindowBackground}"
    mc:Ignorable="d">
    <Grid>
        <!-- Xceed StandardColorPicker 在 Avalonia 下不可用，先用固定色板占位：点击按钮设置 CurrentColor -->
        <StackPanel Margin="10">
            <Border
                Height="40"
                Background="{Binding CurrentColor}"
                BorderBrush="Gray"
                BorderThickness="1" />
            <WrapPanel Margin="0,10,0,0">
                <Button Width="32" Height="32" Margin="2" Background="#FFFFFFFF" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FF000000" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFF0000" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FF00FF00" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FF0000FF" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFFFF00" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFF00FF" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FF00FFFF" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FFFFA500" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FF800080" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FFA52A2A" Click="OnColorButtonClick" />
                <Button Width="32" Height="32" Margin="2" Background="#FF808080" Click="OnColorButtonClick" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>



