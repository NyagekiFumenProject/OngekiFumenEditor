<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls">
    <ControlTheme x:Key="{x:Type controls:CheckListBox}" TargetType="controls:CheckListBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                    <DockPanel>
                        <CheckBox
                            Name="PART_SelectAll"
                            DockPanel.Dock="Top"
                            Margin="4"
                            IsVisible="{TemplateBinding IsSelectAllActive}"
                            Content="{TemplateBinding SelectAllContent}" />
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
