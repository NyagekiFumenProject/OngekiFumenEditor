<views:WindowViewBase
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.SplashScreen.Views.SplashScreenView"
    x:DataType="vm:SplashScreenViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.SplashScreen.ViewModels"
    Title="Welcome"
    Width="1000"
    Height="700"
    BorderThickness="0"
    d:DataContext="{d:DesignInstance Type=vm:SplashScreenViewModel}"
    Background="{StaticResource EditorWindowBackgroundBrush}"
    CanResize="False"
    mc:Ignorable="d">
    <views:WindowViewBase.Styles>
        <Style Selector="Button.ActionCard">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Button.Static.Background}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.ActionCard:pointerover">
            <Setter Property="BorderBrush" Value="LightBlue" />
        </Style>
        <Style Selector="Button.RecentFile">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.RecentFile:pointerover">
            <Setter Property="BorderBrush" Value="LightBlue" />
        </Style>
    </views:WindowViewBase.Styles>
    <Grid Margin="20,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label
                Content="Ongeki Fumen Editor"
                FontSize="40"
                FontWeight="Bold" />
            <TextBlock
                Grid.Column="1"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                Text="{markup:Translate {x:Static languages:Lang+B.RequestRestartProgram}}"
                IsVisible="{CompiledBinding IsRequestRestartProgram}">
            </TextBlock>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Label
                    VerticalAlignment="Center"
                    Content="{markup:Translate {x:Static languages:Lang+B.Languages}}"
                    FontSize="20" />
                <ComboBox
                    Width="250"
                    Height="25"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    ItemsSource="{CompiledBinding Languages}"
                    SelectedItem="{CompiledBinding SelectedLanguage, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="{markup:Translate {x:Static languages:Lang+B.RecentFiles}}" FontSize="20" />
                    <StackPanel
                        Margin="0,5"
                        Orientation="Horizontal"
                        IsVisible="False">
                        <TextBox
                            Width="300"
                            Height="25"
                            VerticalAlignment="Center" />
                        <Button
                            Margin="10,0,0,0"
                            Padding="5"
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <Image Height="20" Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/search.png">
                            </Image>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,10"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ItemsSource="{CompiledBinding GroupedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupedItem">
                                <Expander Header="{CompiledBinding Name}" IsExpanded="True">
                                    <ItemsControl Margin="10,5,10,5" ItemsSource="{CompiledBinding Recents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentFileItemViewModel">
                                                <Button
                                                    Classes="RecentFile"
                                                    Command="{CompiledBinding OpenCommand}">
                                                    <Grid Margin="2,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="40" Height="40">
                                                            <Image Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/file.png" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <Label Content="{CompiledBinding Name}" />
                                                            <Label Content="{CompiledBinding LocationDescription}" />
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Width="100"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Text="{CompiledBinding LastAccessTimeText}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="{markup:Translate {x:Static languages:Lang+B.Start}}" FontSize="20" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="350">

                        <!-- Project creation remains hidden until the project-contained creation flow is implemented.
                        <Button
                            Classes="ActionCard"
                            Command="{CompiledBinding CreateNewProjectCommand}"
                            Margin="0,5,0,5"
                            HorizontalAlignment="Stretch">
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="40"
                                        Height="40"
                                        Margin="10,10,0,10">
                                        <Image Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/add-folder.png" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10"
                                        VerticalAlignment="Center">
                                        <Label
                                            Content="{markup:Translate {x:Static languages:Lang+B.CreateProject}}"
                                            FontSize="20"
                                            FontWeight="Bold" />
                                        <Label Content="{markup:Translate {x:Static languages:Lang+B.CreateProjectTipText}}" FontSize="15" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        -->
                        <Button
                            Classes="ActionCard"
                            Command="{CompiledBinding OpenProjectCommand}"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch">
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="40"
                                        Height="40"
                                        Margin="10,10,0,10">
                                        <Image Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/open-folder.png" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10"
                                        VerticalAlignment="Center">
                                        <Label
                                            Content="{markup:Translate {x:Static languages:Lang+B.OpenProject}}"
                                            FontSize="20"
                                            FontWeight="Bold" />
                                        <Label Content="{markup:Translate {x:Static languages:Lang+B.OpenProjectTipText}}" FontSize="15" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <!-- Fast-open is intentionally unavailable in the cross-platform Core UI.
                        <Button
                            Classes="ActionCard"
                            Command="{CompiledBinding FastOpenCommand}"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch">
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="40"
                                        Height="40"
                                        Margin="10,10,0,10">
                                        <Image Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/document.png" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10"
                                        VerticalAlignment="Center">
                                        <Label
                                            Content="{markup:Translate {x:Static languages:Lang+B.FastOpen2}}"
                                            FontSize="20"
                                            FontWeight="Bold" />
                                        <Label Content="{markup:Translate {x:Static languages:Lang+B.FastOpen2TipText}}" FontSize="15" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        -->
                        <Rectangle
                            Height="2"
                            Margin="10,0,10,5"
                            Fill="LightGray" />
                        <Button
                            Classes="ActionCard"
                            Command="{CompiledBinding OpenTutorialCommand}"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch">
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="40"
                                        Height="40"
                                        Margin="10,10,0,10">
                                        <Image Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/book.png" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10"
                                        VerticalAlignment="Center">
                                        <Label
                                            Content="{markup:Translate {x:Static languages:Lang+B.Tutorial}}"
                                            FontSize="20"
                                            FontWeight="Bold" />
                                        <TextBlock
                                            FontSize="15"
                                            Text="{markup:Translate {x:Static languages:Lang+B.TutorialTipText}}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <CheckBox
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{CompiledBinding DisableShowSplashScreenAfterBoot, Mode=TwoWay}">
                    <TextBlock FontSize="15" Text="{markup:Translate {x:Static languages:Lang+B.NotShowAnymore}}" />
                </CheckBox>
            </Grid>
        </Grid>
    </Grid>
</views:WindowViewBase>
