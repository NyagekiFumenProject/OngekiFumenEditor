<views:WindowViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.ViewModels.Dialogs"
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.Views.Dialogs.EditorProjectSetupDialogView"
    x:CompileBindings="True"
    x:DataType="local:EditorProjectSetupDialogViewModel"
    Title="Project Setup"
    Width="760"
    Height="720"
    MinWidth="560"
    MinHeight="520"
    CanResize="True"
    Background="{StaticResource EditorWindowBackgroundBrush}"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer
            Margin="20,18,0,12"
            Padding="0,0,20,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            IsVisible="{CompiledBinding IsEditing}">
            <StackPanel Spacing="18">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Project" />
                    <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="Project folder"
                            ToolTip.Tip="Destination folder for the new project. Existing files in this folder are not overwritten." />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Text="{CompiledBinding ProjectDirectoryDisplayName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{CompiledBinding ProjectDirectoryDisplayName}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            MinWidth="88"
                            Command="{CompiledBinding SelectProjectDirectoryCommand}"
                            Content="Browse..." />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Project name"
                            ToolTip.Tip="Name used for the project data file. Enter it without the .nyagekiProj extension." />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Text="{CompiledBinding ProjectName, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="Project file"
                            ToolTip.Tip="Preview of the project data file that will be created in the project folder." />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center"
                            Text="{CompiledBinding ProjectFileNamePreview}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>

                <Separator />

                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Audio" />
                    <Grid ColumnDefinitions="140,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="Source audio"
                            ToolTip.Tip="Audio file to validate and bind or copy into the project. The source extension must be supported." />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Text="{CompiledBinding AudioFileDisplayName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{CompiledBinding AudioFileDisplayName}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            MinWidth="88"
                            Command="{CompiledBinding SelectAudioFileCommand}"
                            Content="Browse..." />
                        <Button
                            Grid.Row="0"
                            Grid.Column="3"
                            Command="{CompiledBinding ClearAudioFileCommand}"
                            Content="Clear" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Target name"
                            ToolTip.Tip="File name used inside the project folder for the audio. Keep the source extension; changing the name creates a copy." />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Text="{CompiledBinding TargetAudioFileName, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="Duration"
                            ToolTip.Tip="Detected duration of the selected audio. This value is read-only and is stored in the project data." />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            VerticalAlignment="Center"
                            Text="{CompiledBinding AudioDurationDisplay}" />

                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            IsVisible="{CompiledBinding RequiresExternalAwb}"
                            Text="External AWB"
                            ToolTip.Tip="External AWB archive required by this ACB. The matching archive is copied or bound using the shown target name." />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Spacing="3"
                            IsVisible="{CompiledBinding RequiresExternalAwb}">
                            <TextBlock
                                HorizontalAlignment="Stretch"
                                Text="{CompiledBinding AudioAwbDisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{CompiledBinding AudioAwbDisplayName}" />
                            <TextBlock Opacity="0.72" Text="{CompiledBinding TargetAudioAwbFileName}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator />

                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Fumen" />
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <RadioButton
                            GroupName="FumenMode"
                            IsChecked="{CompiledBinding IsCreateNewFumenMode, Mode=TwoWay}"
                            Content="Create new" />
                        <RadioButton
                            GroupName="FumenMode"
                            IsChecked="{CompiledBinding IsExistingFumenMode, Mode=TwoWay}"
                            Content="Use existing" />
                    </StackPanel>

                    <Grid
                        ColumnDefinitions="140,*,Auto,Auto"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="8"
                        IsVisible="{CompiledBinding IsExistingFumenMode}">
                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="Source fumen"
                            ToolTip.Tip="Existing fumen file used as the starting chart. It is validated before it is bound or copied." />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Text="{CompiledBinding ExistingFumenDisplayName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{CompiledBinding ExistingFumenDisplayName}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            MinWidth="88"
                            Command="{CompiledBinding SelectExistingFumenCommand}"
                            Content="Browse..." />
                        <Button
                            Grid.Row="0"
                            Grid.Column="3"
                            Command="{CompiledBinding ClearExistingFumenCommand}"
                            Content="Clear" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Target name"
                            ToolTip.Tip="File name used inside the project folder for the existing fumen. Keep its extension; changing the name creates a copy." />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Text="{CompiledBinding ExistingFumenTargetFileName, Mode=TwoWay}" />
                    </Grid>

                    <Grid
                        ColumnDefinitions="140,*,180"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="8"
                        IsVisible="{CompiledBinding IsCreateNewFumenMode}">
                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="File name"
                            ToolTip.Tip="Base name for a new fumen. Enter it without an extension, then choose the format from the list." />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{CompiledBinding NewFumenStem, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="2"
                            ItemsSource="{CompiledBinding FumenFormatOptions}"
                            SelectedItem="{CompiledBinding SelectedFumenFormat, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Final file"
                            ToolTip.Tip="Preview of the new fumen file name after the selected format extension is applied." />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center"
                            Text="{CompiledBinding FumenFileNamePreview}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="Initial BPM"
                            ToolTip.Tip="Initial BPM written to a newly created fumen. Enter a finite value greater than 0; 240 is the default." />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="160"
                            HorizontalAlignment="Left"
                            Text="{CompiledBinding BaseBpmText, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <Border
                    Padding="10,8"
                    BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{CompiledBinding HasValidationErrors}">
                    <TextBlock
                        Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                        Text="{CompiledBinding ValidationMessage}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Margin="28"
            VerticalAlignment="Center"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="10"
            IsVisible="{CompiledBinding IsBusy}">
            <TextBlock
                FontSize="17"
                FontWeight="SemiBold"
                AutomationProperties.Name="Project creation status"
                Text="{CompiledBinding ProgressText}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="1"
                MinHeight="24"
                Opacity="0.72"
                Text="{CompiledBinding ProgressFileName}"
                TextTrimming="CharacterEllipsis" />
            <ProgressBar
                Grid.Row="2"
                Height="8"
                AutomationProperties.Name="Project creation progress"
                IsIndeterminate="{CompiledBinding IsProgressIndeterminate}"
                Maximum="{CompiledBinding ProgressMaximum}"
                Value="{CompiledBinding ProgressValue}" />
        </Grid>

        <Border
            Grid.Row="1"
            Padding="20,12"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.72"
                    IsVisible="{CompiledBinding IsEditing}"
                    Text="Files already in the project folder are bound directly."
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    MinWidth="96"
                    IsEnabled="{CompiledBinding CanCancel}"
                    Command="{CompiledBinding CancelCommand}"
                    Content="Cancel" />
                <Button
                    Grid.Column="2"
                    MinWidth="112"
                    IsVisible="{CompiledBinding IsEditing}"
                    IsEnabled="{CompiledBinding CanCreate}"
                    Command="{CompiledBinding CreateCommand}"
                    Content="Create" />
            </Grid>
        </Border>
    </Grid>
</views:WindowViewBase>
