<views:WindowViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.ViewModels.Dialogs"
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.Views.Dialogs.ProjectFileBindingDialogView"
    x:CompileBindings="True"
    x:DataType="viewModels:ProjectFileBindingDialogViewModel"
    Title="Bind project files"
    Width="720"
    Height="320"
    MinWidth="520"
    MinHeight="300"
    Background="{DynamicResource EditorWindowBackgroundBrush}"
    mc:Ignorable="d">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock
            FontSize="18"
            Text="Bind project files" />

        <TextBlock
            Grid.Row="1"
            Margin="0,4,0,20"
            Text="{Binding ProjectLocator}"
            TextTrimming="CharacterEllipsis"
            ToolTip.Tip="{Binding ProjectLocator}" />

        <Grid Grid.Row="2" ColumnDefinitions="112,*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Text="Fumen file" />
            <ComboBox
                Grid.Column="1"
                MinWidth="280"
                ItemsSource="{Binding FumenOptions}"
                SelectedItem="{Binding SelectedFumenOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProjectFileBindingOption">
                        <TextBlock
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                Grid.Column="2"
                MinWidth="92"
                Margin="8,0,0,0"
                Command="{Binding BrowseFumenCommand}"
                Content="Browse..." />
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="112,*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Text="Audio file" />
            <ComboBox
                Grid.Column="1"
                MinWidth="280"
                ItemsSource="{Binding AudioOptions}"
                SelectedItem="{Binding SelectedAudioOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProjectFileBindingOption">
                        <TextBlock
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                Grid.Column="2"
                MinWidth="92"
                Margin="8,0,0,0"
                Command="{Binding BrowseAudioCommand}"
                Content="Browse..." />
        </Grid>

        <StackPanel
            Grid.Row="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="88"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
            <Button
                MinWidth="88"
                Command="{Binding ConfirmCommand}"
                Content="Open" />
        </StackPanel>
    </Grid>
</views:WindowViewBase>
