<views:WindowViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.ViewModels.Dialogs"
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.Views.Dialogs.AwbReplaceConfirmationDialogView"
    x:DataType="viewModels:AwbReplaceConfirmationDialogViewModel"
    Title="Replace AWB file"
    Width="560"
    Height="320"
    MinWidth="460"
    MinHeight="260"
    Background="{DynamicResource EditorWindowBackgroundBrush}"
    mc:Ignorable="d">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock
            Margin="0,0,0,8"
            FontSize="16"
            TextWrapping="Wrap"
            Text="The project already contains an AWB file with the same name, but its content differs." />

        <Grid
            Grid.Row="1"
            Margin="0,4"
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto">
            <TextBlock
                Margin="0,2,8,2"
                Text="Project AWB:" />
            <TextBlock
                Grid.Column="1"
                Margin="0,2"
                TextWrapping="Wrap"
                Text="{Binding ExistingAwbDisplayPath}" />
            <TextBlock
                Grid.Row="1"
                Margin="0,2,8,2"
                Text="Size:" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,2"
                Text="{Binding ExistingAwbSizeText}" />
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="0,4"
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto">
            <TextBlock
                Margin="0,2,8,2"
                Text="Selected AWB:" />
            <TextBlock
                Grid.Column="1"
                Margin="0,2"
                TextWrapping="Wrap"
                Text="{Binding PickedAwbDisplayPath}" />
            <TextBlock
                Grid.Row="1"
                Margin="0,2,8,2"
                Text="Size:" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,2"
                Text="{Binding PickedAwbSizeText}" />
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,10,0,0"
            VerticalAlignment="Top"
            Foreground="{DynamicResource SystemAccentColor}"
            TextWrapping="Wrap"
            Text="Replacing overwrites the project AWB with the selected file. The previous content cannot be restored." />

        <StackPanel
            Grid.Row="4"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <!--  Cancel is intentionally the default-focused button.  -->
            <Button
                x:Name="CancelButton"
                MinWidth="88"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
            <Button
                MinWidth="88"
                Command="{Binding ReplaceCommand}"
                Content="Replace" />
        </StackPanel>
    </Grid>
</views:WindowViewBase>
