<ongekiobjects:OngekiObjectViewBase
    x:Class="OngekiFumenEditor.Avalonia.Modules.EditorSvgObjectControlProvider.Views.SvgPrefabView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ongekiobjects="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.Views"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.Avalonia.Modules.EditorSvgObjectControlProvider.ViewModels"
    mc:Ignorable="d">
    <Canvas>
        <Rectangle
            Width="14"
            Height="14"
            Fill="White">
            <Rectangle.RenderTransform>
                <TranslateTransform X="-7" Y="-7">
                </TranslateTransform>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Image IsHitTestVisible="False">
            <Image.RenderTransform>
                <TranslateTransform X="{Binding Point.X}" Y="{Binding Point.Y}">
                </TranslateTransform>
            </Image.RenderTransform>
            <Image.Source>
                <DrawingImage Drawing="{Binding RefSvgPrefab.ProcessingDrawingGroup}">
                </DrawingImage>
            </Image.Source>
        </Image>
    </Canvas>
</ongekiobjects:OngekiObjectViewBase>



