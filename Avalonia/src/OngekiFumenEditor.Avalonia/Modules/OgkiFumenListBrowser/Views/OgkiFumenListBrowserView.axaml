<views:WindowViewBase
    x:Class="OngekiFumenEditor.Avalonia.Modules.OgkiFumenListBrowser.Views.OgkiFumenListBrowserView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:icons="using:FluentIcons.Avalonia.Fluent"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Modules.OgkiFumenListBrowser.Views"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:OngekiFumenEditor.Avalonia.Modules.OgkiFumenListBrowser.Models"
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.OgkiFumenListBrowser.ViewModels"
    x:DataType="vm:OgkiFumenListBrowserViewModel"
    Title="{markup:Translate {x:Static languages:Lang+B.OgkiFumenListBrowser}}"
    Width="760"
    Height="760"
    MinWidth="560"
    MinHeight="500"
    Background="{DynamicResource EditorWindowBackgroundBrush}"
    Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:OgkiFumenListBrowserViewModel}"
    mc:Ignorable="d">

    <views:WindowViewBase.Resources>
        <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="{DynamicResource SystemRegionColor}" />
        <SolidColorBrush x:Key="BrowserSubtleSurfaceBrush" Color="{DynamicResource SystemChromeLowColor}" />
        <SolidColorBrush x:Key="BrowserBorderBrush" Color="{DynamicResource SystemChromeHighColor}" />
        <SolidColorBrush x:Key="BrowserMutedTextBrush" Color="{DynamicResource SystemBaseMediumColor}" />
        <SolidColorBrush x:Key="BrowserAccentBrush" Color="{DynamicResource SystemAccentColor}" />
        <SolidColorBrush x:Key="BrowserAccentSoftBrush" Color="#220073CF" />
        <SolidColorBrush x:Key="BrowserCardBrush" Color="{DynamicResource SystemAltHighColor}" />
    </views:WindowViewBase.Resources>

    <views:WindowViewBase.Styles>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrowserMutedTextBrush}" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrowserMutedTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="Button.icon-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrowserAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{DynamicResource BrowserAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary-action:pointerover">
            <Setter Property="Opacity" Value="0.86" />
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource BrowserSubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrowserBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary-action:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrowserAccentBrush}" />
        </Style>
        <Style Selector="TextBox.search-box">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource BrowserSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrowserBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.search-box:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrowserAccentBrush}" />
        </Style>
        <Style Selector="Expander.track-expander > ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.track-expander /template/ ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style Selector="Border.difficulty-card">
            <Setter Property="Background" Value="{DynamicResource BrowserSubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrowserBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.load-button">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource BrowserAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BrowserAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.load-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrowserAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </views:WindowViewBase.Styles>

    <Grid Margin="16" RowDefinitions="Auto,*" IsEnabled="{Binding !IsBusy}">
        <Border Grid.Row="0"
                Padding="12"
                Background="{DynamicResource BrowserSurfaceBrush}"
                BorderBrush="{DynamicResource BrowserBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="34"
                            Height="34"
                            Background="{DynamicResource BrowserAccentSoftBrush}"
                            CornerRadius="8">
                        <Image Margin="8"
                               Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/home.png" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="eyebrow" Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserGameRoot}}" />
                        <TextBlock IsVisible="{Binding HasRootFolder}"
                                   FontWeight="SemiBold"
                                   Text="{Binding RootFolderDisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding RootFolderDisplayName}" />
                        <TextBlock IsVisible="{Binding ShowNoRootState}"
                                   Classes="meta"
                                   Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserNoRootSelected}}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary-action"
                            Command="{Binding SelectFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="16"
                                   Height="16"
                                   Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/open-folder.png" />
                            <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.Browser}}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                    <Border Width="34"
                            Height="34"
                            Background="{DynamicResource BrowserSubtleSurfaceBrush}"
                            CornerRadius="8">
                        <Image Margin="8"
                               Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/search.png" />
                    </Border>
                    <TextBox Grid.Column="1"
                             Classes="search-box"
                             Text="{Binding Keywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="{markup:Translate {x:Static languages:Lang+B.KeywordFilter}}">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding ApplyKeywordsCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="2"
                            Classes="icon-button"
                            IsVisible="{Binding HasKeywords}"
                            AutomationProperties.Name="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserClearFilter}}"
                            Command="{Binding ClearKeywordsCommand}"
                            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserClearFilter}}">
                        <icons:FluentIcon Icon="Dismiss" IconSize="Size16" />
                    </Button>
                    <Button Grid.Column="3"
                            Classes="secondary-action"
                            Command="{Binding ApplyKeywordsCommand}"
                            Content="{markup:Translate {x:Static languages:Lang+B.Filter}}" />
                    <Button Grid.Column="4"
                            Classes="icon-button"
                            AutomationProperties.Name="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserRefresh}}"
                            Command="{Binding RefreshListCommand}"
                            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserRefresh}}">
                        <icons:FluentIcon Icon="ArrowSync" IconSize="Size20" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Border IsVisible="{Binding ShowErrorState}"
                    Padding="34"
                    Background="{DynamicResource BrowserSurfaceBrush}"
                    BorderBrush="{DynamicResource BrowserBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel HorizontalAlignment="Center"
                            MaxWidth="440"
                            Spacing="12">
                    <Border Width="58"
                            Height="58"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BrowserAccentSoftBrush}"
                            CornerRadius="16">
                        <Image Margin="14"
                               Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/notication.png" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center"
                               Text="{Binding ErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Center"
                            Classes="primary-action"
                            Command="{Binding RetryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <icons:FluentIcon Icon="ArrowSync" IconSize="Size16" />
                            <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserRetry}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding ShowNoRootState}"
                    Padding="34"
                    Background="{DynamicResource BrowserSurfaceBrush}"
                    BorderBrush="{DynamicResource BrowserBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel HorizontalAlignment="Center"
                            MaxWidth="420"
                            Spacing="12">
                    <Border Width="58"
                            Height="58"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BrowserAccentSoftBrush}"
                            CornerRadius="16">
                        <Image Margin="14"
                               Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/home.png" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserEmptyRootTitle}}" />
                    <Button HorizontalAlignment="Center"
                            Classes="primary-action"
                            Command="{Binding SelectFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="16"
                                   Height="16"
                                   Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/open-folder.png" />
                            <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.SelectGameRootFolder}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding ShowNoResultsState}"
                    Padding="34"
                    Background="{DynamicResource BrowserSurfaceBrush}"
                    BorderBrush="{DynamicResource BrowserBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel HorizontalAlignment="Center"
                            MaxWidth="420"
                            Spacing="12">
                    <Border Width="58"
                            Height="58"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BrowserSubtleSurfaceBrush}"
                            CornerRadius="16">
                        <Image Margin="14"
                               Source="avares://OngekiFumenEditor.Avalonia/Resources/Icons/search.png" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserNoMatchesTitle}}" />
                    <Button HorizontalAlignment="Center"
                            Classes="secondary-action"
                            Command="{Binding ClearKeywordsCommand}">
                        <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserClearFilter}}" />
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer IsVisible="{Binding ShowResults}"
                          IsTabStop="False"
                          ScrollViewer.BringIntoViewOnFocusChange="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayFumenSets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Expanders change item height; keep pixel offsets stable while they open. -->
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:OngekiFumenSet">
                            <Border Margin="0,0,0,10">
                                <Expander Classes="track-expander"
                                          RequestBringIntoView="OnTrackRequestBringIntoView">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="88,*,Auto" ColumnSpacing="14" Margin="14">
                                            <Border Width="88"
                                                    Height="88"
                                                    Background="{DynamicResource BrowserAccentSoftBrush}"
                                                    CornerRadius="10"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="20"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrowserAccentBrush}"
                                                               Text="{Binding MusicId, StringFormat='#{0:0000}'}" />
                                                    <Image EffectiveViewportChanged="OnJacketImageEffectiveViewportChanged"
                                                           Source="{Binding JacketBitmap}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        MinWidth="0"
                                                        Spacing="5">
                                                <TextBlock Classes="eyebrow"
                                                           Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserMusic}}" />
                                                <TextBlock Classes="meta"
                                                           Text="{Binding MusicId, StringFormat='{}{0:0000}'}" />
                                                <TextBlock FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Classes="meta"
                                                           Text="{Binding Artist}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Classes="meta" Text="{Binding Genre}" />
                                                    <TextBlock Classes="meta"
                                                               Text="{Binding Difficults.Count}" />
                                                    <TextBlock Classes="meta"
                                                               Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserChartsLabel}}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <TextBlock Classes="eyebrow"
                                                           HorizontalAlignment="Right"
                                                           Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserCharts}}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Difficults.Count}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <Border Margin="14,0,14,14"
                                            Padding="12"
                                            Background="{DynamicResource BrowserSubtleSurfaceBrush}"
                                            CornerRadius="10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="eyebrow"
                                                           Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserAvailableDifficulties}}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Difficults}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:OngekiFumenDiff">
                                                        <Border Classes="difficulty-card"
                                                                Width="190"
                                                                Margin="0,0,8,8"
                                                                Padding="11">
                                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock FontSize="14"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BrowserAccentBrush}"
                                                                               Text="{Binding DiffName}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Classes="meta"
                                                                               Text="{Binding DiffIdx, StringFormat='#{0}'}" />
                                                                </Grid>
                                                                <StackPanel Grid.Row="1"
                                                                            Orientation="Horizontal"
                                                                            Spacing="5">
                                                                    <TextBlock Classes="eyebrow"
                                                                               VerticalAlignment="Center"
                                                                               Text="{markup:Translate {x:Static languages:Lang+B.DiffLevel}}" />
                                                                    <TextBlock FontSize="20"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding Level, StringFormat='{}{0:0.##}'}" />
                                                                </StackPanel>
                                                                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Classes="eyebrow"
                                                                                   Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserBpm}}" />
                                                                        <TextBlock Text="{Binding Bpm, StringFormat='{}{0:0.##}'}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                                        <TextBlock Classes="eyebrow"
                                                                                   Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserCreator}}" />
                                                                        <TextBlock Classes="meta"
                                                                                   Text="{Binding Creator}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip.Tip="{Binding Creator}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Button Grid.Row="3"
                                                                        Classes="load-button"
                                                                        Command="{Binding $parent[local:OgkiFumenListBrowserView].((vm:OgkiFumenListBrowserViewModel)DataContext).LoadFumenCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text=">" />
                                                                        <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.LoadFumen}}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border IsVisible="{Binding IsBusy}"
                    Background="#B8000000"
                    CornerRadius="14"
                    ZIndex="10">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="260"
                            Spacing="12">
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <TextBlock HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{markup:Translate {x:Static languages:Lang+B.OgkiBrowserWorking}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</views:WindowViewBase>
