<views:WindowViewBase
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.AudioAdjustWindow.Views.AudioAdjustWindowView"
    x:DataType="vm:AudioAdjustWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.AudioAdjustWindow.ViewModels"
    Title="{markup:Translate {x:Static languages:Lang+B.CommandAudioAdjustWindow}}"
    Width="500"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:AudioAdjustWindowViewModel}"
    Background="{StaticResource EditorWindowBackgroundBrush}"
    CanResize="False"
    SizeToContent="WidthAndHeight"
    mc:Ignorable="d" xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls">
    <StackPanel>
        <controls:GroupBox
            Margin="5"
            Foreground="{StaticResource EditorToolWindowForegroundBrush}"
            Header="{markup:Translate {x:Static languages:Lang+B.AudioFileSource}}">
            <StackPanel>
                <RadioButton
                    Margin="0,5,0,5"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding IsUseInputFile, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource EditorToolWindowForegroundBrush}"
                            Text="{markup:Translate {x:Static languages:Lang+B.LoadFromFile}}">
                        </TextBlock>
                        <TextBlock
                            Width="280"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource EditorToolWindowForegroundBrush}"
                            Text="{Binding InputFumenFilePath}"
                            ToolTip.Tip="{Binding InputFumenFilePath}">
                        </TextBlock>
                        <Button
                            Margin="10,0,0,0"
                            Padding="20,2,20,2"
                            Command="{Binding OpenSelectInputFileCommand}"
                            Content="{markup:Translate {x:Static languages:Lang+B.Browser}}"
                            Foreground="{StaticResource EditorToolWindowForegroundBrush}" />
                    </StackPanel>
                </RadioButton>
                <Rectangle
                    Height="1"
                    Margin="10,5,10,5"
                    Stroke="LightGray">
                </Rectangle>
                <RadioButton
                    Margin="0,5,0,5"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding IsCurrentEditorAsInputFumen, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource EditorToolWindowForegroundBrush}"
                            Text="{markup:Translate {x:Static languages:Lang+B.LoadFromCurrentEditor}}">
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource EditorToolWindowForegroundBrush}" Text="{Binding CurrentEditorName}">
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
                <CheckBox
                    Margin="20,0,10,0"
                    VerticalAlignment="Center"
                    Content="{markup:Translate {x:Static languages:Lang+B.AllObjectApplyNewDelayAfterCalculated}}"
                    IsChecked="{Binding IsRecalculateObjects}">
                </CheckBox>
            </StackPanel>
        </controls:GroupBox>

        <controls:GroupBox Margin="5" Header="{markup:Translate {x:Static languages:Lang+B.OffsetOption}}">
            <StackPanel>
                <RadioButton VerticalContentAlignment="Center" GroupName="2857">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="{markup:Translate {x:Static languages:Lang+B.ApplyOffsetBySecond}}">
                        </Label>
                        <TextBox
                            Width="100"
                            VerticalAlignment="Center"
                            Text="{Binding Seconds}">
                        </TextBox>
                        <Label Content="{markup:Translate {x:Static languages:Lang+B.Second}}">
                        </Label>
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    VerticalContentAlignment="Center"
                    GroupName="2857"
                    IsChecked="{Binding IsUseGridOffset, Mode=OneWayToSource}">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="{markup:Translate {x:Static languages:Lang+B.ApplyOffsetByTGrid}}">
                        </Label>
                        <Label>Unit:</Label>
                        <TextBox
                            Width="50"
                            VerticalAlignment="Center"
                            Text="{Binding Unit}" />
                        <Label>Grid:</Label>
                        <TextBox
                            Width="50"
                            VerticalAlignment="Center"
                            Text="{Binding Grid}" />
                        <Label>Bpm:</Label>
                        <TextBox
                            Width="75"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsUseInputFile}"
                            Text="{Binding Bpm}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </controls:GroupBox>

        <controls:GroupBox
            Margin="5"
            Foreground="{StaticResource EditorToolWindowForegroundBrush}"
            Header="{markup:Translate {x:Static languages:Lang+B.Output}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource EditorToolWindowForegroundBrush}"
                    Text="{markup:Translate {x:Static languages:Lang+B.SaveToFile}}">
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource EditorToolWindowForegroundBrush}"
                    Text="{Binding OutputFumenFilePath}">
                </TextBlock>
                <Button
                    Margin="10,0,0,0"
                    Padding="20,2,20,2"
                    Command="{Binding OpenSelectOutputFileCommand}"
                    Content="{markup:Translate {x:Static languages:Lang+B.Browser}}"
                    Foreground="{StaticResource EditorToolWindowForegroundBrush}" />
            </StackPanel>
        </controls:GroupBox>

        <Button
            Margin="5,10,5,5"
            Padding="0,10,0,10"
            Command="{Binding ExecuteConverterCommand}"
            Content="{markup:Translate {x:Static languages:Lang+B.Process}}"
            Foreground="{StaticResource EditorToolWindowForegroundBrush}" />
    </StackPanel>
</views:WindowViewBase>
