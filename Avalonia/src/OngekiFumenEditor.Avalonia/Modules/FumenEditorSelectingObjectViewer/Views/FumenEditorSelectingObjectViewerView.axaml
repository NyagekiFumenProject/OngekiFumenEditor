<UserControl
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenEditorSelectingObjectViewer.Views.FumenEditorSelectingObjectViewerView"
    x:Name="Root"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:OngekiFumenEditor.Avalonia.UI.Behaviors"
    xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:valueconverters="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenEditorSelectingObjectViewer.ValueConverters"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenEditorSelectingObjectViewer.ViewModels"
    xmlns:views="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenEditorSelectingObjectViewer.Views"
    x:DataType="vm:FumenEditorSelectingObjectViewerViewModel"
    d:Background="White"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True,
                                     Type=vm:FumenEditorSelectingObjectViewerViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding CancelSelectedObjectsCommand}" Gesture="Delete" />
    </UserControl.KeyBindings>
    <UserControl.Resources>
        <valueconverters:GetObjectSoflanGroupConverter x:Key="GetObjectSoflanGroupConverter" />
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="Selection">

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DataGrid
            x:Name="listView"
            Grid.Row="1"
            Background="Transparent"
            BorderBrush="Transparent"
            ItemsSource="{Binding EditorSelectObjects}"
            CanUserReorderColumns="True"
            DoubleTapped="OnRowDoubleTapped"
            PointerPressed="OnRowPointerPressed"
            SelectionMode="Extended">
            <Interaction.Behaviors>
                <behaviors:ListViewMultiSelectionBehavior SelectedItems="{Binding SelectedItems}" />
            </Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding #Root.((vm:FumenEditorSelectingObjectViewerViewModel)DataContext).RefreshCommand}" Header="{markup:Translate [Refresh]}" />
                    <MenuItem Command="{Binding #Root.((vm:FumenEditorSelectingObjectViewerViewModel)DataContext).CancelSelectedObjectsCommand}" Header="{markup:Translate [CancelSelected]}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="Foreground" Value="{StaticResource EditorToolWindowForegroundBrush}" />
                </Style>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource EditorToolWindowForegroundBrush}" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>

                <DataGridTemplateColumn Width="100" Header="{markup:Translate [Name]}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SelectedObjectRow">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100" Header="{markup:Translate [ObjectTime]}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SelectedObjectRow">
                            <TextBlock Text="{Binding TGrid}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Width="100" Header="SoflanGroup">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SelectedObjectRow">
                            <Label>
                                <Label.Content>
                                    <MultiBinding Converter="{StaticResource GetObjectSoflanGroupConverter}">
                                        <Binding Path="Object" />
                                        <Binding ElementName="Root" Path="((vm:FumenEditorSelectingObjectViewerViewModel)DataContext).Editor" />
                                    </MultiBinding>
                                </Label.Content>
                            </Label>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="550" Header="{markup:Translate [Description]}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SelectedObjectRow">
                            <TextBlock Text="{Binding Description}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
        </TabItem>

        <TabItem Header="Filter" IsSelected="{Binding IsFilterMenuVisible}">
            <views:SelectionFilterView DataContext="{Binding SelectionFilter}" />
        </TabItem>
    </TabControl>
</UserControl>



