<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenVisualEditorSettings.Views.FumenVisualEditorSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls"
    xmlns:converters="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenVisualEditor.Converters"
    xmlns:converters1="clr-namespace:OngekiFumenEditor.Avalonia.UI.ValueConverters"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:gemini="http://schemas.timjones.io/gemini"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenVisualEditorSettings.ViewModels"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    x:DataType="vm:FumenVisualEditorSettingsViewModel"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:FumenVisualEditorSettingsViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <gekViews:ViewBase.Resources>
        <converters:UnitCloseSizeConverter x:Key="UnitCloseSizeConverter">
        </converters:UnitCloseSizeConverter>
        <converters1:NullToVisibilityConverter x:Key="NullToVisibilityConverter">
        </converters1:NullToVisibilityConverter>
    </gekViews:ViewBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,5,10,5" IsVisible="{Binding Setting, Converter={StaticResource NullToVisibilityConverter}}">
            <CheckBox
                Margin="0,2,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.DisableTGridMagneticDock}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.DisableTGridMagneticDock}}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,2,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.ForceXGridMagneticDock}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.ForceXGridMagneticDock}}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,2,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.DisableXGridMagneticDock}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.DisableXGridMagneticDock}}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,2,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.ForceTapHoldMagneticDockToLane}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.ForceTapHoldMagneticDockToLane}}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,2,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.ForceMagneticDock}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.ForceMagneticDock}}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,2,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.JudgeLineAlignBeat}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.JudgeLineAlignBeat}}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,2,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.AdjustPastedObjects}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.AdjustPastedObjects}}" TextWrapping="Wrap" />
            </CheckBox>
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                    Text="{markup:Translate {x:Static languages:Lang+B.XGridUnitSpace}}"
                    TextWrapping="Wrap">
                </TextBlock>
                <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding UnitCloseSizeValues}"
                    SelectedIndex="4"
                    SelectedValue="{Binding Setting.XGridUnitSpace}">
                </ComboBox>

            </Grid>
            <StackPanel>
                <controls:RangeValue
                    Padding="0,10,0,10"
                    CurrentValue="{Binding Setting.BeatSplit, Mode=TwoWay}"
                    DisplayName="{markup:Translate {x:Static languages:Lang+B.BeatSplit}}"
                    MaxValue="16"
                    MinValue="0"
                    Step="1">
                </controls:RangeValue>
                <controls:RangeValue
                    Padding="0,10,0,10"
                    CurrentValue="{Binding Setting.XGridDisplayMaxUnit, Mode=TwoWay}"
                    DisplayName="{markup:Translate {x:Static languages:Lang+B.XGridDisplayMaxUnit}}"
                    IsEnabled="{Binding Setting.EnableXOffset}"
                    MaxValue="200"
                    MinValue="0"
                    Step="1" />
                <controls:RangeValue
                    Padding="0,10,0,10"
                    CurrentValue="{Binding Setting.JudgeLineOffsetY, Mode=TwoWay}"
                    DisplayName="{markup:Translate {x:Static languages:Lang+B.JudgeLineOffsetY}}"
                    MaxValue="500"
                    MinValue="0"
                    Step="1">
                </controls:RangeValue>
                <controls:RangeValue
                    Padding="0,10,0,10"
                    CurrentValue="{Binding Setting.XOffset, Mode=TwoWay}"
                    DisplayName="{markup:Translate {x:Static languages:Lang+B.XOffset}}"
                    MaxValue="600"
                    MinValue="-600"
                    Step="1" />
                <controls:RangeValue
                    Padding="0,10,0,10"
                    CurrentValue="{Binding Setting.VerticalDisplayScale, Mode=TwoWay}"
                    DisplayName="{markup:Translate {x:Static languages:Lang+B.VerticalDisplayScale}}"
                    MaxValue="3"
                    MinValue="0.1"
                    Step="0.1">
                </controls:RangeValue>
            </StackPanel>
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="8"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                    Text="{markup:Translate {x:Static languages:Lang+B.DisplayTimeFormat}}">
                </TextBlock>
                <ComboBox
                    Grid.Row="8"
                    Grid.Column="1"
                    ItemsSource="{Binding SupportTimeFormats}"
                    SelectedValue="{Binding Setting.DisplayTimeFormat, Converter={StaticResource EnumToStringConverter}}">
                </ComboBox>
            </Grid>
            <CheckBox
                Margin="0,10,0,2"
                VerticalContentAlignment="Center"
                IsChecked="{Binding Setting.LoopPlayTiming}">
                <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.EnableLoopPlayTiming}}" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
    </ScrollViewer>
</gekViews:ViewBase>



