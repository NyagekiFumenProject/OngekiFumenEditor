<Window
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.Dialog.BrushTGridRangeDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:OngekiFumenEditor.Avalonia.UI.Behaviors"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:dialog="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.ViewModels.Dialog"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties" xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    Title="{markup:Translate [BrushTGridRangeDialog]}"
    Width="220"
    d:DataContext="{d:DesignInstance Type=dialog:BrushTGridRangeDialogViewModel}"
    Background="{StaticResource EnvironmentWindowBackground}"
    SizeToContent="WidthAndHeight"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock
                    Width="80"
                    VerticalAlignment="Center"
                    Text="From TGrid" />
                <StackPanel Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unit:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding BeginTGrid.Unit}" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock Text="Grid:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding BeginTGrid.Grid}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock
                    Width="80"
                    VerticalAlignment="Center"
                    Text="To TGrid" />
                <StackPanel Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unit:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding EndTGrid.Unit}" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock Text="Grid:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding EndTGrid.Grid}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Margin="10"
                Padding="10,5,10,5"
                Content="{markup:Translate [Confirm]}">
                <Interaction.Behaviors>
                    <behaviors:EventMethodBehavior EventName="Click" MethodName="OnComfirmButtonClicked" />
                </Interaction.Behaviors>
            </Button>
            <Button
                Grid.Column="1"
                Margin="10"
                Padding="10,5,10,5"
                Content="{markup:Translate [Cancel]}">
                <Interaction.Behaviors>
                    <behaviors:EventMethodBehavior EventName="Click" MethodName="OnCancelButtonClicked" />
                </Interaction.Behaviors>
            </Button>
        </Grid>
    </Grid>
</Window>



