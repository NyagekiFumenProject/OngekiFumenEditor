<views:WindowViewBase
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.Dialog.BrushTGridRangeDialogView"
    x:CompileBindings="True"
    x:DataType="dialog:BrushTGridRangeDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:dialog="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.ViewModels.Dialog"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    Title="{markup:Translate {x:Static languages:Lang+B.BrushTGridRangeDialog}}"
    Width="220"
    d:DataContext="{d:DesignInstance Type=dialog:BrushTGridRangeDialogViewModel}"
    Background="{StaticResource EditorWindowBackgroundBrush}"
    SizeToContent="WidthAndHeight"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock
                    Width="80"
                    VerticalAlignment="Center"
                    Text="From TGrid" />
                <StackPanel Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unit:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding BeginTGrid.Unit}" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock Text="Grid:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding BeginTGrid.Grid}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock
                    Width="80"
                    VerticalAlignment="Center"
                    Text="To TGrid" />
                <StackPanel Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unit:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding EndTGrid.Unit}" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock Text="Grid:" />
                        <TextBox
                            Width="60"
                            Margin="5,0,0,0"
                            Text="{Binding EndTGrid.Grid}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Margin="10"
                Padding="10,5,10,5"
                Command="{Binding ConfirmCommand}"
                Content="{markup:Translate {x:Static languages:Lang+B.Confirm}}" />
            <Button
                Grid.Column="1"
                Margin="10"
                Padding="10,5,10,5"
                Command="{Binding CancelCommand}"
                Content="{markup:Translate {x:Static languages:Lang+B.Cancel}}" />
        </Grid>
    </Grid>
</views:WindowViewBase>
