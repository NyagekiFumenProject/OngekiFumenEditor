<UserControl
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.BeamOperationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:OngekiFumenEditor.Avalonia.UI.Behaviors"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    d:Background="White"
    mc:Ignorable="d">
    <StackPanel Margin="21,5,0,0" IsVisible="{Binding IsEnableDrag, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border
            x:Name="BeamNext"
            Width="130"
            HorizontalAlignment="Left"
            BorderBrush="Black"
            BorderThickness="1">
            <Interaction.Behaviors>
                <behaviors:EventMethodBehavior EventName="PointerMoved" MethodName="Border_MouseMove" PassMode="ExecutionContext" />
                <behaviors:EventMethodBehavior EventName="PointerPressed" MethodName="Border_MouseLeftButtonDown" PassMode="ExecutionContext" />
            </Interaction.Behaviors>
            <TextBlock
                Margin="5"
                Foreground="{DynamicResource EnvironmentToolWindowText}"
                Text="Drag new BeamNext"
                TextWrapping="Wrap" />
        </Border>
        <Border
            Width="130"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            BorderBrush="Black"
            BorderThickness="1">
            <Interaction.Behaviors>
                <behaviors:EventMethodBehavior EventName="PointerMoved" MethodName="Border_MouseMove2" PassMode="ExecutionContext" />
                <behaviors:EventMethodBehavior EventName="PointerPressed" MethodName="Border_MouseLeftButtonDown" PassMode="ExecutionContext" />
            </Interaction.Behaviors>
            <TextBlock
                Margin="5"
                Foreground="{DynamicResource EnvironmentToolWindowText}"
                Text="Drag new BeamEnd" />
        </Border>
    </StackPanel>
</UserControl>



