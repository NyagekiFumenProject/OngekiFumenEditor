<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.BeamOperationView"
    x:CompileBindings="True"
    x:DataType="vm:BeamOperationViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.ViewModels"
    d:Background="White"
    mc:Ignorable="d">
    <StackPanel Margin="21,5,0,0">
        <Border
            x:Name="BeamNext"
            Width="130"
            HorizontalAlignment="Left"
            BorderBrush="Black"
            BorderThickness="1"
            PointerMoved="OnNextPointerMoved"
            PointerPressed="OnPointerPressed">
            <TextBlock
                Margin="5"
                Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                Text="Drag new BeamNext"
                TextWrapping="Wrap" />
        </Border>
        <Border
            Width="130"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            BorderBrush="Black"
            BorderThickness="1"
            PointerMoved="OnEndPointerMoved"
            PointerPressed="OnPointerPressed">
            <TextBlock
                Margin="5"
                Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                Text="Drag new BeamEnd" />
        </Border>
    </StackPanel>
</gekViews:ViewBase>



