<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.ConnectableObjectOperationView"
    x:CompileBindings="True"
    x:DataType="vm:ConnectableObjectOperationViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.UI.Controls"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:ConnectableObjectOperationViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <StackPanel Margin="21,5,0,0">
        <controls:CommonOperationButton
            Width="150"
            HorizontalAlignment="Left"
            DecoratorBrush="Green"
            Cursor="Hand"
            PointerMoved="OnNextPointerMoved"
            PointerPressed="OnPointerPressed"
            Text="{markup:Translate {x:Static languages:Lang+B.DragToCreateNext}}"
            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.DragToCreateNextToolTip}}" />
        <!--<controls:CommonOperationButton
            Width="150"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            ToolTip.Tip="终点拖动入口暂未启用；启用时应复用本视图的强类型指针事件桥接。"
            DecoratorBrush="DarkBlue"
            Text="拖动添加终点"
            IsVisible="{Binding IsEnableDragEnd, Converter={StaticResource BoolToVisibilityConverter}}" />-->
        <Border
            Height="2"
            Margin="-21,10,0,0"
            BorderBrush="Black"
            BorderThickness="1" />
        <controls:CommonOperationButton
            Width="150"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            DecoratorBrush="DarkCyan"
            Cursor="Hand"
            PointerMoved="OnSplitPointerMoved"
            PointerPressed="OnPointerPressed"
            Text="{markup:Translate {x:Static languages:Lang+B.DragToSplit}}"
            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.DragToSplitTipText}}" />
        <controls:CommonOperationButton
            Width="150"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            DecoratorBrush="DarkKhaki"
            Cursor="Hand"
            PointerMoved="OnCurvePathControlPointerMoved"
            PointerPressed="OnPointerPressed"
            Text="{markup:Translate {x:Static languages:Lang+B.DragToCreateCurveControlPoint}}"
            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.DragToCreateCurveControlPointTipText}}"
            IsVisible="{Binding IsEnableDragPathControl, Converter={StaticResource BoolToVisibilityConverter}}" />
        <Button
            Width="150"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Padding="5"
            Background="Transparent"
            BorderBrush="DarkOrchid"
            BorderThickness="1,1,25,1"
            Command="{CompiledBinding InterpolateCommand}"
            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.InterpolateLaneTipText}}"
            IsVisible="{Binding IsStartObject, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                Text="{markup:Translate {x:Static languages:Lang+B.InterpolateLane}}"
                TextWrapping="Wrap" />
        </Button>
        <Button
            Width="150"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Padding="5"
            Background="Transparent"
            BorderBrush="Tomato"
            BorderThickness="1,1,25,1"
            Command="{CompiledBinding BrushAlongLaneCommand}"
            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.BrushAlongLaneTipText}}"
            IsVisible="{Binding IsStartObject, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                Text="{markup:Translate {x:Static languages:Lang+B.BrushAlongLane}}"
                TextWrapping="Wrap" />
        </Button>
        <Button
            Width="150"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Padding="5"
            Background="Transparent"
            BorderBrush="DarkGoldenrod"
            BorderThickness="1,1,25,1"
            Command="{CompiledBinding InterpolatePartCommand}"
            ToolTip.Tip="{markup:Translate {x:Static languages:Lang+B.InterpolatePartTipText}}"
            IsVisible="{Binding IsStartObject, Converter={StaticResource ReverseBoolToVisibilityConverter}}">
            <TextBlock
                Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                Text="{markup:Translate {x:Static languages:Lang+B.InterpolatePart}}"
                TextWrapping="Wrap" />
        </Button>
    </StackPanel>
</gekViews:ViewBase>



