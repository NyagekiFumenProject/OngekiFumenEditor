<UserControl
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.Views.HoldOperationView"
    x:CompileBindings="True"
    x:DataType="vm:HoldOperationViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenObjectPropertyBrowser.ViewModels"
    d:Background="White"
    mc:Ignorable="d">
    <StackPanel Margin="21,5,0,0" IsVisible="{Binding IsEnableDrag, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border
            Width="130"
            HorizontalAlignment="Left"
            BorderBrush="Black"
            BorderThickness="1"
            PointerMoved="OnPointerMoved"
            PointerPressed="OnPointerPressed">
            <TextBlock
                Margin="5"
                Foreground="{DynamicResource EditorToolWindowForegroundBrush}"
                Cursor="Hand"
                Text="{markup:Translate [DragToCreateHoldEnd]}"
                ToolTip.Tip="{markup:Translate [DragToCreateHoldEndTipText]}"
                TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>



