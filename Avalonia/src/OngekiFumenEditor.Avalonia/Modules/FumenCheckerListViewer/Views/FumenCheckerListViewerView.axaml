<UserControl
    x:Class="OngekiFumenEditor.Avalonia.Modules.FumenCheckerListViewer.Views.FumenCheckerListViewerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:behaviors="clr-namespace:OngekiFumenEditor.Avalonia.UI.Behaviors"
    xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:converters="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenCheckerListViewer.ValueConverters"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Modules.FumenCheckerListViewer.Views"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DataContext="{d:DesignInstance Type=local:FumenCheckerListViewerViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToNotShowTextConverter x:Key="BoolToNotShowTextConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="128*" />
            <RowDefinition Height="141*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="5,5,5,5" Orientation="Horizontal">
            <Button
                Margin="0,0,5,0"
                Padding="20,2,20,2"
                Content="{markup:Translate [Refresh]}"
                IsEnabled="{Binding IsEnable, Mode=OneWay}">
                <Interaction.Behaviors>
                    <behaviors:EventMethodBehavior EventName="Click" MethodName="RefreshCurrentFumen" />
                </Interaction.Behaviors>
            </Button>
            <ToggleButton
                Background="Transparent"
                BorderBrush="Red"
                IsChecked="{Binding EnableShowError}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Symbol"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="⮿">
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        Padding="10,2,10,2"
                        VerticalAlignment="Center">
                        <Run Text="{markup:Translate [Error]}">
                        </Run>
                        <Run Text="{Binding ErrorCount, Mode=OneWay}" />
                        <Run Text="{Binding EnableShowError, Mode=OneWay, Converter={StaticResource BoolToNotShowTextConverter}}" />
                    </TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton
                Margin="5,0,0,0"
                Background="Transparent"
                BorderBrush="LightGreen"
                IsChecked="{Binding EnableShowProblem}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Symbol"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="LightGreen"
                        Text="">
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        Padding="10,2,10,2"
                        VerticalAlignment="Center">
                        <Run Text="{markup:Translate [Problem]}">
                        </Run>
                        <Run Text="{Binding ProblemCount, Mode=OneWay}" />
                        <Run Text="{Binding EnableShowProblem, Mode=OneWay, Converter={StaticResource BoolToNotShowTextConverter}}" />
                    </TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton
                Margin="5,0,0,0"
                Background="Transparent"
                BorderBrush="SkyBlue"
                IsChecked="{Binding EnableShowSuggest}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Symbol"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="SkyBlue"
                        Text="">
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        Padding="10,2,10,2"
                        VerticalAlignment="Center">
                        <Run Text="{markup:Translate [Advice]}">
                        </Run>
                        <Run Text="{Binding SuggestCount, Mode=OneWay}" />
                        <Run Text="{Binding EnableShowSuggest, Mode=OneWay, Converter={StaticResource BoolToNotShowTextConverter}}" />
                    </TextBlock>
                </StackPanel>
            </ToggleButton>
        </StackPanel>
        <DataGrid
            Grid.RowSpan="3"
            Margin="0,31,0,0"
            CanUserReorderColumns="True"
            ItemsSource="{Binding CheckResults}">
            <Interaction.Behaviors>
                <behaviors:EventMethodBehavior EventName="Loaded" MethodName="OnListViewLoaded" PassMode="ExecutionContext" />
            </Interaction.Behaviors>
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="Interaction.Behaviors">
                        <BehaviorCollectionTemplate>
                            <BehaviorCollection>
                                <behaviors:EventMethodBehavior EventName="DoubleTapped" MethodName="OnItemDoubleClick" PassMode="DataContext" />
                            </BehaviorCollection>
                        </BehaviorCollectionTemplate>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource EnvironmentToolWindowText}" />
                </Style>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource EnvironmentToolWindowText}" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Severity}"
                    Header="{markup:Translate [Severity]}">

                </DataGridTextColumn>

                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding RuleName}"
                    Header="{markup:Translate [RuleName]}">

                </DataGridTextColumn>

                <DataGridTextColumn
                    Width="400"
                    Binding="{Binding Description}"
                    Header="{markup:Translate [Description]}">

                </DataGridTextColumn>

                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding LocationDescription}"
                    Header="{markup:Translate [WrongLocation2]}">

                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>



