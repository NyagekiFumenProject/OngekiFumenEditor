<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.TGridCalculatorToolViewer.Views.TGridCalculatorToolViewerView"
    x:DataType="vm:TGridCalculatorToolViewerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:gemini="http://schemas.timjones.io/gemini"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.TGridCalculatorToolViewer.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:TGridCalculatorToolViewerViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel IsEnabled="{Binding IsEnabled}">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TGrid.Unit:" />
                    <TextBox
                        Width="80"
                        Margin="10,0,0,0"
                        Text="{Binding Unit}" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Text="TGrid.Grid:" />
                    <TextBox
                        Width="80"
                        Margin="10,0,0,0"
                        Text="{Binding Grid}" />
                </StackPanel>
            </StackPanel>
            <Grid Height="20" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Margin="0,0,20,0" Command="{Binding UpdateToTGridCommand}">
                    ↑
                </Button>
                <Button
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Command="{Binding UpdateToMsecCommand}">
                    ↓
                </Button>
            </Grid>
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mesc:" />
                    <TextBox
                        Width="80"
                        Margin="10,0,0,0"
                        Text="{Binding MsecStr}" />
                </StackPanel>
            </StackPanel>

            <controls:GroupBox Header="{markup:Translate {x:Static languages:Lang+B.Action}}">
                <StackPanel>
                    <Button
                        Margin="5,5,0,5"
                        Padding="2,5,2,5"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ScrollEditorToTGridCommand}">
                        <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.EditorJumpToSpecifyTGrid}}" TextWrapping="Wrap" />
                    </Button>
                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalContentAlignment="Center"
                        IsChecked="{Binding IsAutoUpdateTimeIfSelectedObject}">
                        <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.AutoUpdateCurrentObjectTime}}" TextWrapping="Wrap" />
                    </CheckBox>
                    <Button
                        Margin="5,5,0,5"
                        Padding="2,5,2,5"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ApplyTGridToObjectCommand}"
                        IsVisible="{Binding IsSelectedObject, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{markup:Translate {x:Static languages:Lang+B.GiveTGridToSelectedObject}}" TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </controls:GroupBox>
        </StackPanel>
    </ScrollViewer>
</gekViews:ViewBase>



