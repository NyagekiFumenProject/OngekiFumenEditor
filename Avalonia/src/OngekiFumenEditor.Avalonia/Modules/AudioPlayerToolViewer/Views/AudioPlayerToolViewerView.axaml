<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Modules.AudioPlayerToolViewer.Views.AudioPlayerToolViewerView"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls"
    xmlns:converters1="clr-namespace:OngekiFumenEditor.Avalonia.Modules.AudioPlayerToolViewer.Converters"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:gemini="http://schemas.timjones.io/gemini"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Modules.AudioPlayerToolViewer.Views"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:OngekiFumenEditor.Avalonia.Modules.AudioPlayerToolViewer.Models"
    xmlns:objectinspector="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls.ObjectInspector"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Modules.AudioPlayerToolViewer.ViewModels"
    x:DataType="vm:AudioPlayerToolViewerViewModel"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:AudioPlayerToolViewerViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <gekViews:ViewBase.Resources>
        <converters1:IntToTimeDisplayConverter x:Key="IntToTimeDisplayConverter">
        </converters1:IntToTimeDisplayConverter>
    </gekViews:ViewBase.Resources>
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Margin="10"
                IsEnabled="{Binding IsAudioButtonEnabled}"
                IsVisible="{Binding IsShowWaveform, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static sys:Boolean.TrueString}}">
                <Line Height="2" Stroke="Red">
                </Line>

                <ContentControl
                    x:Name="renderControlHost"
                    Height="150"
                    Loaded="OnWaveformHostLoaded"
                    Unloaded="OnWaveformHostUnloaded">
                </ContentControl>

                <!--<wpf:GLWpfControl
                    x:Name="glView"
                    Height="150"
                    Margin="0,0,0,5"
                    Ready="GLWpfControl_Ready"
                    SizeChanged="GLWpfControl_SizeChanged">
                </wpf:GLWpfControl>-->

                <StackPanel Margin="0,5,0,5">
                    <controls:GroupBox Foreground="{StaticResource EditorToolWindowForegroundBrush}" Header="{markup:Translate [VisualizerRenderOption]}">
                        <StackPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="77*" />
                                    <ColumnDefinition Width="298*" />
                                    <ColumnDefinition Width="376*" />
                                </Grid.ColumnDefinitions>

                                <controls:RangeValue
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,10,0"
                                    Padding="0,5,0,5"
                                    CurrentValue="{Binding CurrentTimeXOffset, Mode=TwoWay}"
                                    DisplayName="{markup:Translate [CurrentTimeOffset]}"
                                    MaxValue="{Binding #renderControlHost.Bounds.Width}"
                                    MinValue="0"
                                    Step="1">
                                </controls:RangeValue>
                                <controls:RangeValue
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    Padding="0,5,0,5"
                                    CurrentValue="{Binding DurationMsPerPixel, Mode=TwoWay}"
                                    DisplayName="{markup:Translate [VisualizerHorizonScale]}"
                                    MaxValue="50"
                                    MinValue="2.5"
                                    Step="2.5">
                                </controls:RangeValue>
                                <controls:RangeValue
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,10,0"
                                    Padding="0,5,0,5"
                                    CurrentValue="{Binding ResampleSize, Mode=TwoWay}"
                                    DisplayName="{markup:Translate [Resample]}"
                                    MaxValue="30"
                                    MinValue="0"
                                    Step="1" />
                                <controls:RangeValue
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="10,10,0,0"
                                    Padding="0,5,0,5"
                                    CurrentValue="{Binding WaveformVecticalScale, Mode=TwoWay}"
                                    DisplayName="{markup:Translate [VisualizerVerticalScale]}"
                                    MaxValue="1.5"
                                    MinValue="0.01"
                                    Step="0.01" />
                            </Grid>
                            <controls:GroupBox Header="{markup:Translate [VisualizerSpecialOption]}">
                                <StackPanel>
                                    <objectinspector:ObjectInspectorView Margin="5" InspectObject="{Binding WaveformDrawing.Options}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Padding="5,2,5,2"
                                            Command="{Binding ResetWaveformOptionsCommand}"
                                            Content="{markup:Translate [ResetDefault]}" />
                                        <Button
                                            Margin="5,0"
                                            Padding="5,2,5,2"
                                            Command="{Binding SaveWaveformOptionsCommand}"
                                            Content="{markup:Translate [Save]}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:GroupBox>
                        </StackPanel>
                    </controls:GroupBox>
                </StackPanel>
            </StackPanel>

            <Grid
                Grid.Row="1"
                Margin="10,0,10,10"
                VerticalAlignment="Center"
                IsEnabled="{Binding IsAudioButtonEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:GroupBox Foreground="{StaticResource EditorToolWindowForegroundBrush}" Header="{markup:Translate [SoundSwitchControl]}">
                    <StackPanel>
                        <WrapPanel x:Name="SoundControlSwitches">
                            <WrapPanel.Styles>
                                <Style Selector="CheckBox">
                                    <Setter Property="Margin" Value="5" />
                                    <Setter Property="Foreground" Value="{StaticResource EditorToolWindowForegroundBrush}">
                                    </Setter>
                                </Style>
                            </WrapPanel.Styles>
                            <CheckBox Content="Tap" IsChecked="{Binding SoundControls[0]}" />
                            <CheckBox Content="CriticalTap" IsChecked="{Binding SoundControls[1]}" />
                            <CheckBox Content="Hold" IsChecked="{Binding SoundControls[2]}" />
                            <CheckBox Content="CriticalHold" IsChecked="{Binding SoundControls[3]}" />
                            <CheckBox Content="WallTap" IsChecked="{Binding SoundControls[4]}" />
                            <CheckBox Content="CriticalWallTap" IsChecked="{Binding SoundControls[5]}" />
                            <CheckBox Content="WallHold" IsChecked="{Binding SoundControls[6]}" />
                            <CheckBox Content="CriticalWallHold" IsChecked="{Binding SoundControls[7]}" />
                            <CheckBox Content="Flick" IsChecked="{Binding SoundControls[8]}" />
                            <CheckBox Content="CriticalFlick" IsChecked="{Binding SoundControls[9]}" />
                            <CheckBox Content="Bell" IsChecked="{Binding SoundControls[12]}" />
                            <CheckBox Content="Beam" IsChecked="{Binding SoundControls[11]}" />
                            <CheckBox Content="Bullet" IsChecked="{Binding SoundControls[10]}" />
                            <CheckBox Content="ClickSE" IsChecked="{Binding SoundControls[13]}" />
                            <CheckBox Content="HoldTick" IsChecked="{Binding SoundControls[14]}" />
                            <CheckBox Content="HoldEnd" IsChecked="{Binding SoundControls[15]}" />
                            <CheckBox Content="MetronomeStrongBeat" IsChecked="{Binding SoundControls[19]}" />
                            <CheckBox Content="MetronomeWeakBeat" IsChecked="{Binding SoundControls[20]}" />
                            <CheckBox Content="BossWave" IsChecked="{Binding SoundControls[21]}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding SoundVolumes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SoundVolumeProxy">
                                    <StackPanel Margin="5" Orientation="Horizontal">
                                        <TextBlock
                                            Width="70"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}">
                                        </TextBlock>
                                        <Slider
                                            Width="150"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            LargeChange="0.2"
                                            Maximum="1"
                                            SmallChange="0.02"
                                            Value="{Binding Volume}">
                                        </Slider>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <Button
                                Padding="5,2,5,2"
                                Command="{Binding ReloadSoundFilesCommand}"
                                Content="{markup:Translate [ReloadSoundFile]}" />
                        </StackPanel>
                    </StackPanel>
                </controls:GroupBox>

                <controls:GroupBox
                    Grid.Column="1"
                    Margin="10"
                    Foreground="{StaticResource EditorToolWindowForegroundBrush}"
                    Header="{markup:Translate [SwitchControl]}">
                    <StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Text="Limit FPS:" />
                            <TextBox
                                Width="50"
                                Margin="5,0"
                                Text="{Binding LimitFPS}" />
                            <TextBlock x:Name="noLimitText" Text="{markup:Translate [NoLimit]}">
                                <Interaction.Behaviors>
                                    <DataTriggerBehavior
                                        Binding="{Binding LimitFPS}"
                                        ComparisonCondition="LessThanOrEqual"
                                        Value="0">
                                        <ChangePropertyAction
                                            PropertyName="IsVisible"
                                            TargetObject="{Binding #noLimitText}"
                                            Value="True" />
                                    </DataTriggerBehavior>
                                    <DataTriggerBehavior
                                        Binding="{Binding LimitFPS}"
                                        ComparisonCondition="GreaterThan"
                                        Value="0">
                                        <ChangePropertyAction
                                            PropertyName="IsVisible"
                                            TargetObject="{Binding #noLimitText}"
                                            Value="False" />
                                    </DataTriggerBehavior>
                                </Interaction.Behaviors>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox
                            Margin="5"
                            Content="{markup:Translate [EnableVisualizerDisplay]}"
                            IsChecked="{Binding IsShowWaveform}">
                        </CheckBox>

                        <Grid
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding AudioPlayer.IsPlaying, Converter={StaticResource ReverseBoolConverter}}"
                            IsVisible="{Binding CanAdjustMusicSpeed}">
                            <controls:RangeValue
                                Grid.ColumnSpan="2"
                                Padding="0,5,0,5"
                                CurrentValue="{Binding MusicSpeed, Mode=TwoWay}"
                                DisplayName="{markup:Translate [Speed]}"
                                MaxValue="1.25"
                                MinValue="0.75"
                                Step="0.05">
                            </controls:RangeValue>
                        </Grid>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{markup:Translate [Music]}">
                            </TextBlock>
                            <Slider
                                Width="150"
                                Margin="5,0,0,0"
                                VerticalAlignment="Stretch"
                                IsEnabled="{Binding AudioPlayer.IsAvaliable}"
                                LargeChange="0.2"
                                Maximum="1"
                                SmallChange="0.2"
                                Value="{Binding MusicVolume}">
                            </Slider>
                        </StackPanel>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{markup:Translate [Sound]}">
                            </TextBlock>
                            <Slider
                                Width="150"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                LargeChange="0.2"
                                Maximum="1"
                                SmallChange="0.2"
                                Value="{Binding SoundVolume}">
                            </Slider>
                        </StackPanel>
                    </StackPanel>
                </controls:GroupBox>
            </Grid>

            <StackPanel Grid.Row="2">
            </StackPanel>
        </Grid>
    </ScrollViewer>
</gekViews:ViewBase>
