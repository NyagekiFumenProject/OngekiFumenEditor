<views:WindowViewBase
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Kernel.ProgramUpdater.Dialogs.Views.ShowNewVersionDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:OngekiFumenEditor.Avalonia.UI.Behaviors"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.ProgramUpdater.Dialogs.Views"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.ProgramUpdater.Dialogs.ViewModels"
    Title="{markup:Translate [ShowNewVersionTitle]}"
    d:DataContext="{d:DesignInstance Type=vm:ShowNewVersionDialogViewModel}"
    Background="{DynamicResource EnvironmentWindowBackground}"
    CanResize="False"
    SizeToContent="WidthAndHeight"
    mc:Ignorable="d">
    <StackPanel>
        <Grid Margin="10,15,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Label
                VerticalAlignment="Center"
                Content="{markup:Translate [CurrentVersion]}"
                FontSize="15" />
            <Label
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                d:Content="1.2.3"
                Content="{Binding CurrentVersion}"
                FontSize="15"
                FontWeight="Bold">
            </Label>

            <Label
                Grid.Row="1"
                VerticalAlignment="Center"
                Content="{markup:Translate [NewVersion]}"
                FontSize="15">
            </Label>
            <Label
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center"
                d:Content="1.5.8"
                Content="{Binding NewVersionInfo.Version}"
                FontSize="15"
                FontWeight="Bold">
            </Label>

            <Label
                Grid.Row="2"
                VerticalAlignment="Center"
                Content="{markup:Translate [Branch]}"
                FontSize="15">
            </Label>
            <Label
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Center"
                d:Content="master"
                Content="{Binding NewVersionInfo.Branch}"
                FontSize="15"
                FontWeight="Bold">
            </Label>

            <Label
                Grid.Row="3"
                VerticalAlignment="Center"
                Content="{markup:Translate [FileSize]}"
                FontSize="15">
            </Label>
            <Label
                Grid.Row="3"
                Grid.Column="1"
                VerticalAlignment="Center"
                d:Content="30.54 GB"
                Content="{Binding NewVersionInfo.FileSize, Converter={StaticResource DisplayFileSizeConverter}}"
                FontSize="15"
                FontWeight="Bold">
            </Label>

            <Label
                Grid.Row="4"
                VerticalAlignment="Center"
                Content="{markup:Translate [ReleaseTime]}"
                FontSize="15">
            </Label>
            <Label
                Grid.Row="4"
                Grid.Column="1"
                VerticalAlignment="Center"
                d:Content="2012/10/14 30:26:59.123"
                Content="{Binding NewVersionInfo.Time}"
                FontSize="15"
                FontWeight="Bold">
            </Label>
        </Grid>
        <CheckBox
            Margin="10,0"
            HorizontalAlignment="Right"
            Content="{markup:Translate [UpdateProgramReady]}"
            IsChecked="{Binding IsReady}" />
        <Button
            Margin="5,10,5,5"
            Padding="10"
            Content="{markup:Translate [UpdateStart]}"
            IsEnabled="{Binding IsReady}">
            <Interaction.Behaviors>
                <behaviors:EventMethodBehavior EventName="Click" MethodName="StartUpdate" />
            </Interaction.Behaviors>
        </Button>
    </StackPanel>
</views:WindowViewBase>



