<views:WindowViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.Graphics.Performence.ViewModels"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Kernel.Graphics.Performence.Views.RenderPerfomenceMeasurePanelView"
    x:DataType="vm:RenderPerfomenceMeasurePanelViewModel"
    Title="{markup:Translate {x:Static languages:Lang+B.RenderPerfomenceMeasurePanelTitle}}"
    Width="900" Height="650" MinWidth="600" MinHeight="400"
    Background="{DynamicResource EditorWindowBackgroundBrush}">
    <Grid Margin="8">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="{markup:Translate {x:Static languages:Lang+B.RenderPerfomenceMeasurePanelNoContext}}"
                   IsVisible="{Binding HasNoRenderContexts}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasRenderContexts}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RenderPerfomenceMeasureItem">
                        <Expander Margin="0,0,0,8" IsExpanded="True" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel MaxWidth="780">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding HeaderTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Opacity="0.8" Text="{Binding HeaderContext}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Opacity="0.8" Text="{Binding HeaderMonitor}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <StackPanel Margin="8,8,8,0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{markup:Translate {x:Static languages:Lang+B.RenderPerfomenceMeasurePanelMonitor}}" />
                                    <ComboBox Width="280" ItemsSource="{Binding PerfomenceMonitorOptions}"
                                              SelectedItem="{Binding SelectedPerfomenceMonitorOption, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PerfomenceMonitorOption">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Border Margin="8" Padding="8" BorderBrush="Gray" BorderThickness="1">
                                    <TextBlock FontFamily="Consolas, monospace" Text="{Binding StatisticsText}" />
                                </Border>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</views:WindowViewBase>
