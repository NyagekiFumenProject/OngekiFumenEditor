<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Kernel.SettingPages.Audio.Views.AudioSettingView"
    x:CompileBindings="True"
    x:DataType="vm:AudioSettingViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.Audio.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True,
                                     Type=vm:AudioSettingViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d" xmlns:controls="clr-namespace:OngekiFumenEditor.Avalonia.UI.Controls">
    <StackPanel>
        <controls:GroupBox Margin="5" Header="{markup:Translate [Output]}">
            <StackPanel Margin="10">
                <StackPanel IsVisible="{Binding CanSelectAudioOutput}" Orientation="Horizontal">
                    <Label Content="{markup:Translate [OutputMethod]}" />
                    <ComboBox
                        Width="100"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding AudioOutputTypeValues}"
                        SelectedItem="{Binding SelectedAudioOutputType, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock
                    IsVisible="{Binding HasFixedAudioOutput}"
                    Text="{Binding FixedAudioOutputDescription}" />
                <TextBlock
                    Margin="0,5,0,0"
                    Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                    IsVisible="{Binding HasAudioOutputFallback}"
                    Text="{Binding AudioOutputFallbackMessage}"
                    TextWrapping="Wrap" />
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Label Content="{markup:Translate [SampleRates]}" />
                    <TextBox
                        Width="75"
                        VerticalAlignment="Center"
                        Text="{Binding Setting.AudioSampleRate}" />
                </StackPanel>
            </StackPanel>
        </controls:GroupBox>
        <controls:GroupBox
            Margin="5"
            Header="{markup:Translate [Music]}"
            IsVisible="{Binding SupportsVarspeed}">
            <StackPanel Margin="10">
                <CheckBox
                    VerticalContentAlignment="Center"
                    Content="{markup:Translate [EnableVarspeed]}"
                    IsChecked="{Binding Setting.EnableVarspeed}" />
                <StackPanel
                    Margin="20,10,0,0"
                    IsEnabled="{Binding Setting.EnableVarspeed}"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [VarspeedReadDurationMs]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Text="{Binding Setting.VarspeedReadDurationMs}">
                    </TextBox>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [Millisecond]}" />
                </StackPanel>
            </StackPanel>
        </controls:GroupBox>
        <controls:GroupBox Margin="5" Header="{markup:Translate [Sound]}">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [SoundFolderPath]}" />
                    <TextBox
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        Text="{Binding Setting.SoundFolderPath}">
                    </TextBox>
                    <Button
                        Grid.Column="2"
                        Padding="20,2,20,2"
                        Command="{Binding SelectSoundFolderCommand}"
                        Content="{markup:Translate [Browser]}" />
                </Grid>

                <CheckBox
                    Margin="0,10,0,0"
                    Content="Allow one sound to be played multiple times at the same time. (require restart program)"
                    IsChecked="{Binding Setting.EnableSoundMultiPlay}" />
            </StackPanel>
        </controls:GroupBox>
        <controls:GroupBox Margin="5" Header="{markup:Translate [Visualizer]}">
            <StackPanel Margin="10">
                <CheckBox Content="{markup:Translate [EnableVisualizerDisplay]}" IsChecked="{Binding PlayerSetting.EnableWaveformDisplay}" />
            </StackPanel>
        </controls:GroupBox>
    </StackPanel>
</gekViews:ViewBase>



