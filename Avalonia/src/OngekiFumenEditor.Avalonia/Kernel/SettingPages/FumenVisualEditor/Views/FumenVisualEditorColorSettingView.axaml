<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Kernel.SettingPages.FumenVisualEditor.Views.FumenVisualEditorColorSettingView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.FumenVisualEditor.Models"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:valueconverters="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.FumenVisualEditor.ValueConverters"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.FumenVisualEditor.ViewModels"
    xmlns:views="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.FumenVisualEditor.Views"
    x:DataType="vm:FumenVisualEditorColorSettingViewModel"
    d:Background="White"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True,
                                     Type=vm:FumenVisualEditorColorSettingViewModel}"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ItemsControl
        ItemsSource="{Binding ColorsProperties}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ColorPropertyWrapper">
                <Grid Margin="5">
                    <Label VerticalAlignment="Center" Content="{Binding Name}" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="25"
                            Margin="5,0"
                            Background="{Binding Brush}"
                            CornerRadius="7" />
                        <Label VerticalAlignment="Center" Content="{Binding ColorString}" />
                        <Button
                            Margin="5,0"
                            Padding="10,2"
                            Command="{Binding $parent[views:FumenVisualEditorColorSettingView].((vm:FumenVisualEditorColorSettingViewModel)DataContext).SelectColorCommand}"
                            CommandParameter="{Binding}"
                            Content="{markup:Translate {x:Static languages:Lang+B.Change}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</gekViews:ViewBase>



