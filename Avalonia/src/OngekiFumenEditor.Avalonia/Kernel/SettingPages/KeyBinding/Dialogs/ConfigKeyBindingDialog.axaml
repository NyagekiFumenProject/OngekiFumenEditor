<Window
    x:Class="OngekiFumenEditor.Avalonia.Kernel.SettingPages.KeyBinding.Dialogs.ConfigKeyBindingDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:markup="clr-namespace:OngekiFumenEditor.Avalonia.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{markup:Translate [AssignKeybind]}"
    Width="300"
    Background="{DynamicResource EnvironmentWindowBackground}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.DataContext>
        <Binding RelativeSource="{RelativeSource Self}">
        </Binding>
    </Window.DataContext>
    <StackPanel Margin="10">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="16" >
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocalizeConverter}">
                    <markup:Translate>
                        <x:Arguments>
                            <x:String>[AssignKeyBinding]</x:String>
                        </x:Arguments>
                    </markup:Translate>
                    <Binding Path="Definition.Name"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBlock
            Margin="0,15"
            HorizontalAlignment="Center"
            FontSize="25"
            FontWeight="Bold"
            Text="{Binding CurrentExpression}">
        </TextBlock>
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="16"
            IsVisible="{Binding ConflictDefinition,Converter={StaticResource NullToVisibilityConverter} }"
            Foreground="OrangeRed"
            FontWeight="Bold" >
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocalizeConverter}">
                    <markup:Translate>
                        <x:Arguments>
                            <x:String>[KeyBindingConflictDetect]</x:String>
                        </x:Arguments>
                    </markup:Translate>
                    <Binding Path="ConflictDefinition.Name"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ConfirmButton"
                Margin="5"
                Padding="10,5,10,5"
                Content="{markup:Translate [Comfirm]}"
                FontSize="16">
            </Button>

            <Button
                x:Name="ClearButton"
                Grid.Column="1"
                Margin="5"
                Padding="10,5,10,5"
                Content="{markup:Translate [Clear]}"
                FontSize="16">
            </Button>

            <Button
                x:Name="ResetButton"
                Grid.Column="2"
                Margin="5"
                Padding="10,5,10,5"
                Content="{markup:Translate [Reset]}"
                FontSize="16">
            </Button>
        </Grid>
    </StackPanel>
</Window>



