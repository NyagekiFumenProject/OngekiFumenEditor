<views:WindowViewBase
    x:Class="OngekiFumenEditor.Avalonia.Kernel.SettingPages.KeyBinding.Dialogs.ConfigKeyBindingDialog"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Gekimini.Avalonia.Modules.Window.Views;assembly=Gekimini.Avalonia"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.KeyBinding.Dialogs"
    x:DataType="local:ConfigKeyBindingDialog"
    Title="{markup:Translate {x:Static languages:Lang+B.AssignKeybind}}"
    Width="300"
    Background="{DynamicResource EditorWindowBackgroundBrush}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <StackPanel Margin="10">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="16">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocalizeConverter}">
                    <Binding Path="Text" Source="{x:Static languages:Lang+B.AssignKeyBinding}" />
                    <Binding Path="Definition.Name" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBlock
            Margin="0,15"
            HorizontalAlignment="Center"
            FontSize="25"
            FontWeight="Bold"
            Text="{Binding CurrentExpression}">
        </TextBlock>
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="16"
            IsVisible="{Binding ConflictDefinition,Converter={StaticResource NullToVisibilityConverter} }"
            Foreground="OrangeRed"
            FontWeight="Bold">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocalizeConverter}">
                    <Binding Path="Text" Source="{x:Static languages:Lang+B.KeyBindingConflictDetect}" />
                    <Binding Path="ConflictDefinition.Name" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ConfirmButton"
                Margin="5"
                Padding="10,5,10,5"
                Content="{markup:Translate {x:Static languages:Lang+B.Comfirm}}"
                FontSize="16">
            </Button>

            <Button
                x:Name="ClearButton"
                Grid.Column="1"
                Margin="5"
                Padding="10,5,10,5"
                Content="{markup:Translate {x:Static languages:Lang+B.Clear}}"
                FontSize="16">
            </Button>

            <Button
                x:Name="ResetButton"
                Grid.Column="2"
                Margin="5"
                Padding="10,5,10,5"
                Content="{markup:Translate {x:Static languages:Lang+B.Reset}}"
                FontSize="16">
            </Button>
        </Grid>
    </StackPanel>
</views:WindowViewBase>



