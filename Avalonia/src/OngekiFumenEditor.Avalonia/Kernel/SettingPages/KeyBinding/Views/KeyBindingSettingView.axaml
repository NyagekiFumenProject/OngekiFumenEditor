<gekViews:ViewBase
    xmlns:gekViews="clr-namespace:Gekimini.Avalonia.Views;assembly=Gekimini.Avalonia"
    x:Class="OngekiFumenEditor.Avalonia.Kernel.SettingPages.KeyBinding.Views.KeyBindingSettingView"
    x:CompileBindings="True"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:languages="clr-namespace:OngekiFumenEditor.Avalonia.Assets.Languages"
    xmlns:markup="clr-namespace:Gekimini.Avalonia.Framework.Markup;assembly=Gekimini.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:keybinding="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.KeyBinding"
    xmlns:res="clr-namespace:OngekiFumenEditor.Avalonia.Properties"
    xmlns:valueconverters="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.KeyBinding.ValueConverters"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.KeyBinding.ViewModels"
    xmlns:views="clr-namespace:OngekiFumenEditor.Avalonia.Kernel.SettingPages.KeyBinding.Views"
    x:DataType="vm:KeyBindingSettingViewModel"
    d:Background="White"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True,
                                     Type=vm:KeyBindingSettingViewModel}"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <gekViews:ViewBase.Resources>
        <valueconverters:ShowKeybindExpressionValueConverter x:Key="ShowKeybindExpressionValueConverter" />
    </gekViews:ViewBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,5,15,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    Text="{markup:Translate {x:Static languages:Lang+B.KeywordFilter}}" />
                <TextBox
                    Width="200"
                    Margin="10,0"
                    Padding="0,4"
                    Text="{Binding FilterKeywords}" />

            </StackPanel>
            <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                <CheckBox
                    VerticalAlignment="Center"
                    Content="{markup:Translate {x:Static languages:Lang+B.ShowNotAssignKeybindingOnly}}"
                    IsChecked="{Binding IsShowNotAssignOnly}" />
            </StackPanel>
            <Grid Margin="0,0,0,10">
                <Button
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    Command="{Binding UpdateDisplayListCommand}"
                    Content="{markup:Translate {x:Static languages:Lang+B.ApplyFilter}}" />
                <Button
                    Margin="0,0"
                    Padding="10,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding ResetAllDefinitionsCommand}"
                    Content="{markup:Translate {x:Static languages:Lang+B.ResetAllKeybindings}}" />
            </Grid>
            <Border Height="1" Background="Gray" />
        </StackPanel>
        <ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding Definitions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="keybinding:KeyBindingDefinition">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding DisplayName}"
                            TextWrapping="WrapWithOverflow" />
                        <Label
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Black">
                            <Label.Content>
                                <MultiBinding Converter="{StaticResource ShowKeybindExpressionValueConverter}">
                                    <Binding Path="Key" />
                                    <Binding Path="Modifiers" />
                                </MultiBinding>
                            </Label.Content>
                        </Label>
                        <Button
                            Grid.Column="2"
                            Margin="30,3,3,3"
                            Padding="10,5"
                            Command="{Binding $parent[views:KeyBindingSettingView].((vm:KeyBindingSettingViewModel)DataContext).ChangeKeybindCommand}"
                            CommandParameter="{Binding}"
                            Content="{markup:Translate {x:Static languages:Lang+B.Change}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</gekViews:ViewBase>



