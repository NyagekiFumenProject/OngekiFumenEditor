<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>preview</LangVersion>
        <InjectioDuplicateStrategy>Append</InjectioDuplicateStrategy>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="InjectioDuplicateStrategy" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <DefineConstants>TRACE;AVALONIA_BROWSER;</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <DefineConstants>AVALONIA_BROWSER;</DefineConstants>
        <RunAOTCompilation>true</RunAOTCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <WasmEnableThreads>true</WasmEnableThreads>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug"/>
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia\Gekimini.Avalonia.csproj"/>
        <ProjectReference Include="..\..\Dependencies\NAudio.BrowserAudioWorklet\src\NAudio.BrowserAudioWorklet\NAudio.BrowserAudioWorklet.csproj" />

        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="true" Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\Injectio\src\Injectio.Attributes\Injectio.Attributes.csproj"/>
        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="false" Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\Injectio\src\Injectio.Generators\Injectio.Generators.csproj"/>
        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="true" Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia.Attributes\Gekimini.Avalonia.Attributes.csproj"/>
        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="false" Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia.Generator\Gekimini.Avalonia.Generator.csproj"/>
        <ProjectReference OutputItemType="Analyzer" ReferenceOutputAssembly="false" Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\SimpleTypedLocalizer\SimpleTypedLocalizer.SourceGenerator\SimpleTypedLocalizer.SourceGenerator\SimpleTypedLocalizer.SourceGenerator.csproj" />
        <ProjectReference Include="..\OngekiFumenEditor.Avalonia\OngekiFumenEditor.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Modules\BrowserOpfsBrowser\Assets\Languages\*.json" />
        <AdditionalFiles Include="Modules\BrowserOpfsBrowser\Views\*.axaml" />
        <AdditionalFiles Include="Assets\Languages\BrowserAudioWorkletLang.json" />
        <AdditionalFiles Include="Assets\Languages\BrowserAudioWorkletLang.zh-Hans.json" />
        <AdditionalFiles Include="Assets\Languages\BrowserAudioWorkletLang.ja.json" />
        <AdditionalFiles Include="Kernel\SettingPages\Audio\Views\BrowserAudioWorkletSettingView.axaml" />
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Keep the local ACB parser and its dependencies in trimmed WebAssembly publishes. -->
        <TrimmerRootAssembly Include="DereTore.Exchange.Archive.ACB" />
        <TrimmerRootAssembly Include="DereTore.Common" />
        <TrimmerRootAssembly Include="DereTore.Exchange.Audio.HCA" />
        <TrimmerRootAssembly Include="DereTore.Interop.OS" />
    </ItemGroup>
    <ItemGroup>
        <!-- The shared core references these legacy DLLs through HintPath. Declare them here too so the Browser linker can resolve and root them. -->
        <Reference Include="DereTore.Common">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Common.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="DereTore.Exchange.Archive.ACB">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Exchange.Archive.ACB.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="DereTore.Exchange.Audio.HCA">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Exchange.Audio.HCA.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="DereTore.Interop.OS">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Interop.OS.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
</Project>
