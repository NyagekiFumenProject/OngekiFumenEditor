<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <RootNamespace>OngekiFumenEditor.Avalonia.Browser</RootNamespace>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
        <OutputType>Exe</OutputType>
        <DotNetJsApi>true</DotNetJsApi>
        <PublishTrimmed>true</PublishTrimmed>
        <InvariantGlobalization>true</InvariantGlobalization>
        <NativeDebugSymbols>false</NativeDebugSymbols>
        <StackTraceSupport>false</StackTraceSupport>
        <DebugType>none</DebugType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InjectioDuplicateStrategy>Append</InjectioDuplicateStrategy>
        <IlcHostPackagePath Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'true'">$(Pkgruntime_win-x64_Microsoft_DotNet_ILCompiler_LLVM)</IlcHostPackagePath>
        <IlcHostPackagePath Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'false'">$(Pkgruntime_linux-x64_Microsoft_DotNet_ILCompiler_LLVM)</IlcHostPackagePath>
        <UseAppHost>false</UseAppHost>
        <UsingBrowserRuntimeWorkload>false</UsingBrowserRuntimeWorkload>
        <UsingWasiRuntimeWorkload>false</UsingWasiRuntimeWorkload>
        <UsingEmscriptenWorkload>true</UsingEmscriptenWorkload>
    </PropertyGroup>
    <ItemGroup>
        <EmccExportedRuntimeMethod Include="GL" />
        <CompilerVisibleProperty Include="InjectioDuplicateStrategy" />
    </ItemGroup>
    <PropertyGroup>
        <EmccExtraArgs>$(EmccExtraArgs) -lcompiler_rt-wasm-sjlj</EmccExtraArgs>
        <EmccFlags>$(EmccFlags) -sUSE_WEBGL2=1 -sMAX_WEBGL_VERSION=2 -lGL -Oz</EmccFlags>
    </PropertyGroup>
    <ItemGroup>
        <WasmExtraFilesToDeploy Include="wwwroot\**" />
    </ItemGroup>
    <ItemGroup>
        <!-- Keep browser-only XAML and localization inputs visible to the source generators. -->
        <AdditionalFiles Include="Modules\BrowserOpfsBrowser\Assets\Languages\*.json" />
        <AdditionalFiles Include="Modules\BrowserOpfsBrowser\Views\*.axaml" />
        <AdditionalFiles Include="Modules\SplashScreen\Views\*.axaml" />
        <AdditionalFiles Include="Assets\Languages\BrowserAudioWorkletLang.json" />
        <AdditionalFiles Include="Assets\Languages\BrowserAudioWorkletLang.zh-Hans.json" />
        <AdditionalFiles Include="Assets\Languages\BrowserAudioWorkletLang.ja.json" />
        <AdditionalFiles Include="Kernel\SettingPages\Audio\Views\BrowserAudioWorkletSettingView.axaml" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" />
        <PackageReference Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'true'"
                          Include="runtime.win-x64.Microsoft.DotNet.ILCompiler.LLVM" />
        <PackageReference Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'false'"
                          Include="runtime.linux-x64.Microsoft.DotNet.ILCompiler.LLVM" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <ProjectReference Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia\Gekimini.Avalonia.csproj" />
        <ProjectReference Include="..\..\Dependencies\NAudio.BrowserAudioWorklet\src\NAudio.BrowserAudioWorklet\NAudio.BrowserAudioWorklet.csproj" />
        <ProjectReference OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"
                          Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\Injectio\src\Injectio.Attributes\Injectio.Attributes.csproj" />
        <ProjectReference OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\Injectio\src\Injectio.Generators\Injectio.Generators.csproj" />
        <ProjectReference OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"
                          Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia.Attributes\Gekimini.Avalonia.Attributes.csproj" />
        <ProjectReference OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Include="..\..\Dependencies\Gekimini.Avalonia\src\Gekimini.Avalonia.Generator\Gekimini.Avalonia.Generator.csproj" />
        <ProjectReference OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Include="..\..\Dependencies\Gekimini.Avalonia\Dependencies\SimpleTypedLocalizer\SimpleTypedLocalizer.SourceGenerator\SimpleTypedLocalizer.SourceGenerator\SimpleTypedLocalizer.SourceGenerator.csproj" />
        <ProjectReference Include="..\OngekiFumenEditor.Avalonia\OngekiFumenEditor.Avalonia.csproj" />
    </ItemGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <DefineConstants>TRACE;AVALONIA_BROWSER;LLVM_BUILD;</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <DefineConstants>AVALONIA_BROWSER;LLVM_BUILD;</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="HarfBuzzSharp" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.HarfBuzz" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    </ItemGroup>
    <PropertyGroup>
        <ExecutableExtensionName Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'true'">.exe</ExecutableExtensionName>
    </PropertyGroup>
    <ItemGroup>
        <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_LLVM_ROOT=$(EmscriptenUpstreamBinPath)" />
        <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(EmscriptenSdkToolsPath)" />
        <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_NODE_JS=$(EmscriptenNodeBinPath)node$(ExecutableExtensionName)" />
        <EmscriptenEnvVars Include="EM_CACHE=$(EmscriptenCacheSdkCacheDir)" />
    </ItemGroup>
    <ItemGroup>
        <NativeLibrary Include="$(SkiaSharpStaticLibraryPath)/3.1.56/st/*.a" />
        <NativeLibrary Include="$(HarfBuzzSharpStaticLibraryPath)/3.1.56/st/*.a" />
        <DirectPInvoke Include="libSkiaSharp" />
        <DirectPInvoke Include="libHarfBuzzSharp" />
    </ItemGroup>
    <ItemGroup>
        <UnmanagedEntryPointsAssembly Include="Avalonia.Browser" />
    </ItemGroup>
    <ItemGroup>
        <!-- Keep the local ACB parser and its dependencies in trimmed WebAssembly publishes. -->
        <TrimmerRootAssembly Include="DereTore.Exchange.Archive.ACB" />
        <TrimmerRootAssembly Include="DereTore.Common" />
        <TrimmerRootAssembly Include="DereTore.Exchange.Audio.HCA" />
        <TrimmerRootAssembly Include="DereTore.Interop.OS" />
    </ItemGroup>
    <ItemGroup>
        <!-- The shared core references these legacy DLLs through HintPath. Declare them here too so the Browser linker can resolve and root them. -->
        <Reference Include="DereTore.Common">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Common.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="DereTore.Exchange.Archive.ACB">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Exchange.Archive.ACB.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="DereTore.Exchange.Audio.HCA">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Exchange.Audio.HCA.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="DereTore.Interop.OS">
            <HintPath>..\..\..\OngekiFumenEditor\Dependencies\DereTore\DereTore.Interop.OS.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
</Project>
