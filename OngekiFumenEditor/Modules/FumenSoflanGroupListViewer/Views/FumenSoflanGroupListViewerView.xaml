<UserControl
    x:Class="OngekiFumenEditor.Modules.FumenSoflanGroupListViewer.Views.FumenSoflanGroupListViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:markup="clr-namespace:OngekiFumenEditor.UI.Markup"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Modules.FumenSoflanGroupListViewer.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="800"
    xmlns:valueconverters="clr-namespace:OngekiFumenEditor.Modules.FumenSoflanGroupListViewer.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <valueconverters:DepthToControlMarginConverter x:Key="DepthToControlMargin" />
        <valueconverters:DepthToNameMarginConverter x:Key="DepthToNameMargin" />
    </UserControl.Resources>
    <Grid IsEnabled="{Binding IsEditorAvailable}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="4,0"
            Orientation="Horizontal">
            <ToolBar>
                <CheckBox
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    Content="{markup:Translate [IsaPlacementToggleText]}"
                    IsChecked="{Binding IsIsaPlacementEnabled, Mode=TwoWay}"
                    ToolTip="{Binding IsaPlacementToolTip}" />
                <Button
                    cal:Message.Attach="CreateNewGroup"
                    Content="{markup:Translate [NewItemGroup]}"
                    ToolTip="{markup:Translate [SoflanGroupCreateTipText]}" />
                <Button
                    cal:Message.Attach="CreateNewCategory"
                    Content="{markup:Translate [SoflanGroupNewCategory]}"
                    ToolTip="{markup:Translate [SoflanGroupCreateCategoryTipText]}" />
                <Separator />
                <Button
                    cal:Message.Attach="RenameSelected"
                    Content="{markup:Translate [SoflanGroupRename]}"
                    ToolTip="{markup:Translate [SoflanGroupRenameTipText]}" />
                <Button
                    cal:Message.Attach="DeleteSelected"
                    Content="{markup:Translate [SoflanGroupDelete]}"
                    ToolTip="{markup:Translate [SoflanGroupDeleteTipText]}" />
                <Button
                    cal:Message.Attach="MoveSelectedToRoot"
                    Content="{markup:Translate [SoflanGroupMoveToRoot]}"
                    ToolTip="{markup:Translate [SoflanGroupMoveToRootTipText]}" />
            </ToolBar>
        </StackPanel>

        <TreeView
            x:Name="GroupTree"
            Grid.Row="1"
            Grid.Column="0"
            AllowDrop="True"
            Background="Transparent"
            DragOver="OnGroupTreeDragOver"
            Drop="OnGroupTreeDrop"
            ItemsSource="{Binding RootNodes}"
            PreviewMouseLeftButtonDown="OnGroupTreePreviewMouseLeftButtonDown"
            PreviewMouseMove="OnGroupTreePreviewMouseMove"
            SelectedItemChanged="OnGroupTreeSelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate
                    DataType="{x:Type vm:SoflanGroupTreeNodeViewModel}"
                    ItemsSource="{Binding Children}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Margin="{Binding Depth, Converter={StaticResource DepthToNameMargin}}"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Border
                                Width="12"
                                Height="12"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Background="{Binding ColorBrush}"
                                CornerRadius="2" />
                            <TextBlock
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding ToolTipText}"
                                VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDefaultGroup}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border
                                Margin="6,0,0,0"
                                Padding="4,0"
                                Background="#22000000"
                                CornerRadius="2"
                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    FontSize="11"
                                    Text="{Binding IdLabel}" />
                            </Border>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="{Binding Depth, Converter={StaticResource DepthToControlMargin}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Text="D"
                                ToolTip="{Binding DesignToolTip}" />
                            <CheckBox
                                IsChecked="{Binding VisibleInDesign}"
                                ToolTip="{Binding DesignToolTip}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="{Binding Depth, Converter={StaticResource DepthToControlMargin}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Text="P"
                                ToolTip="{Binding PreviewToolTip}" />
                            <CheckBox
                                IsChecked="{Binding VisibleInPreview}"
                                ToolTip="{Binding PreviewToolTip}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Margin="{Binding Depth, Converter={StaticResource DepthToControlMargin}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Text="S"
                                ToolTip="{Binding DrawToolTip}" />
                            <RadioButton
                                GroupName="SoflanGroupDrawn"
                                IsChecked="{Binding IsDrawn}"
                                ToolTip="{Binding DrawToolTip}" />
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Grid Grid.Row="0" Grid.Column="1">
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{Binding SelectedTitle}"
                TextWrapping="Wrap" />
        </Grid>

        <ListView
            Grid.Row="1"
            Grid.Column="1"
            Background="Transparent"
            ItemsSource="{Binding DisplaySoflanPointList}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="cal:Message.Attach" Value="[Event MouseDoubleClick]=[Action OnItemDoubleClick($dataContext)];" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource EnvironmentToolWindowText}" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Width="120" DisplayMemberBinding="{Binding Y, StringFormat={}{0:0.##}}">
                        <GridViewColumn.Header>
                            <TextBlock Text="Y" ToolTip="{markup:Translate [SoflanPointColumnYTipText]}" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding TGrid}">
                        <GridViewColumn.Header>
                            <TextBlock Text="TGrid" ToolTip="{markup:Translate [SoflanPointColumnTGridTipText]}" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding Bpm.BPM, StringFormat={}{0:0.###}}">
                        <GridViewColumn.Header>
                            <TextBlock Text="Bpm" ToolTip="{markup:Translate [SoflanPointColumnBpmTipText]}" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding Speed, StringFormat={}{0:0.####}}">
                        <GridViewColumn.Header>
                            <TextBlock Text="Speed" ToolTip="{markup:Translate [SoflanPointColumnSpeedTipText]}" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
