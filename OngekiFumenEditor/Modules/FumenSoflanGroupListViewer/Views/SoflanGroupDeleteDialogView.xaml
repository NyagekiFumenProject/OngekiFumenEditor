<UserControl
    x:Class="OngekiFumenEditor.Modules.FumenSoflanGroupListViewer.Views.SoflanGroupDeleteDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:p="clr-namespace:OngekiFumenEditor.Properties"
    MinWidth="420">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Margin="16">
        <TextBlock
            Text="{Binding Message}"
            TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{x:Static p:Resources.SoflanGroupDeleteDialogTransferLabel}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="180"
                DisplayMemberPath="DisplayName"
                IsEnabled="{Binding CanTransfer}"
                ItemsSource="{Binding GroupOptions}"
                SelectedItem="{Binding SelectedAlternative}" />
        </Grid>

        <TextBlock
            Margin="0,6,0,0"
            Foreground="#C0504D"
            Text="{x:Static p:Resources.SoflanGroupDeleteDialogCannotTransfer}"
            TextWrapping="Wrap"
            Visibility="{Binding ShowCannotTransfer, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="110"
                Margin="0,0,8,0"
                cal:Message.Attach="TransferAndDelete"
                Content="{x:Static p:Resources.SoflanGroupDeleteDialogTransferAndDelete}"
                IsEnabled="{Binding CanTransfer}" />
            <Button
                MinWidth="120"
                Margin="0,0,8,0"
                cal:Message.Attach="DeleteReferences"
                Content="{x:Static p:Resources.SoflanGroupDeleteDialogDeleteReferences}" />
            <Button
                MinWidth="80"
                cal:Message.Attach="Cancel"
                Content="{x:Static p:Resources.Cancel}" />
        </StackPanel>
    </StackPanel>
</UserControl>
