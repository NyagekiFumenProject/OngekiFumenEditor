<mah:MetroWindow
    x:Class="OngekiFumenEditor.Modules.FumenVisualEditor.Views.Dialogs.EditorLoadingDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:markup="clr-namespace:OngekiFumenEditor.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Modules.FumenVisualEditor.ViewModels.Dialogs"
    Title="{markup:Translate [EditorLoadingDialogTitle]}"
    Width="440"
    Background="{DynamicResource EnvironmentWindowBackground}"
    ResizeMode="NoResize"
    ShowMaxRestoreButton="False"
    ShowMinButton="False"
    SizeToContent="Height"
    Style="{DynamicResource MainWindowStyle}"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance Type=vm:EditorLoadingDialogViewModel}"
    mc:Ignorable="d">
    <StackPanel Margin="20,18,20,18">
        <!-- 正在加载的目标，用户据此确认打开的是哪个谱面/工程 -->
        <TextBlock
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{DynamicResource EnvironmentToolWindowText}"
            Text="{Binding TargetText}"
            TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Foreground="{DynamicResource EnvironmentToolWindowText}"
                Text="{Binding StepText}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Bottom"
                Foreground="{DynamicResource EnvironmentToolWindowText}"
                Opacity="0.7"
                Text="{Binding StepProgressText}" />
        </Grid>

        <ProgressBar
            Margin="0,10,0,0"
            Height="8"
            Maximum="{Binding StepCount, Mode=OneWay}"
            Value="{Binding StepNumber, Mode=OneWay}" />

        <Button
            Margin="0,16,0,0"
            Padding="14,5,14,5"
            HorizontalAlignment="Right"
            AutomationProperties.AutomationId="EditorLoadingCancelButton"
            cal:Message.Attach="[Event Click] = [Action Cancel()]"
            Content="{markup:Translate [EditorLoadingCancel]}"
            IsEnabled="{Binding CanCancel}" />
    </StackPanel>
</mah:MetroWindow>
