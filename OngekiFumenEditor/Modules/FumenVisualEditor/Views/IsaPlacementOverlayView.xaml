<UserControl
    x:Class="OngekiFumenEditor.Modules.FumenVisualEditor.Views.IsaPlacementOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="clr-namespace:OngekiFumenEditor.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:OngekiFumenEditor.Modules.FumenVisualEditor.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:FumenVisualEditorViewModel}"
    d:DesignHeight="180"
    d:DesignWidth="280"
    mc:Ignorable="d">
    <Border
        Margin="0,0,12,12"
        Padding="12,8"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Background="{DynamicResource EnvironmentWindowBackground}"
        BorderBrush="#40000000"
        BorderThickness="1"
        CornerRadius="3">
        <StackPanel MinWidth="200">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{markup:Translate [IsaPlacementOverlayTitle]}" />
                <Button
                    Padding="6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    cal:Message.Attach="CancelIsaPlacement"
                    Content="{markup:Translate [IsaPlacementOverlayCancel]}" />
            </Grid>
            <TextBlock Margin="0,6,0,0" Text="{Binding IsaPlacementOverlaySummary}" />
            <CheckBox
                Margin="0,4,0,0"
                Content="{markup:Translate [IsaPlacementContinuousText]}"
                IsChecked="{Binding IsContinuousIsaPlacement}"
                ToolTip="{markup:Translate [IsaPlacementContinuousTipText]}" />
        </StackPanel>
    </Border>
</UserControl>
