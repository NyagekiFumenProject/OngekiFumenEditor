<UserControl
    x:Class="OngekiFumenEditor.Kernel.SettingPages.Audio.Views.AudioSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:converters="clr-namespace:OngekiFumenEditor.Kernel.SettingPages.Audio.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="clr-namespace:OngekiFumenEditor.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Properties"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Kernel.SettingPages.Audio.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True,
                                     Type=vm:AudioSettingViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Gemini;component/Themes/SettingsToolTips.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ResourceKeyToTextConverter x:Key="ResourceKeyToTextConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <GroupBox Margin="5" Header="{markup:Translate [Output]}">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{markup:Translate [OutputMethod]}" />
                    <ComboBox
                        Width="100"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioOutputType]}"
                        ItemsSource="{Binding AudioOutputTypeValues}"
                        SelectedIndex="{Binding Setting.AudioOutputType}" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Label Content="{markup:Translate [SampleRates]}" />
                    <TextBox
                        Width="75"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioSampleRate]}"
                        Text="{Binding Setting.AudioSampleRate}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="{markup:Translate [Music]}">
            <StackPanel Margin="10">
                <CheckBox
                    VerticalContentAlignment="Center"
                    Content="{markup:Translate [EnableVarspeed]}"
                    ToolTip="{markup:Translate [SettingsToolTipAudioEnableVarspeed]}"
                    IsChecked="{Binding Setting.EnableVarspeed}" />
                <StackPanel
                    Margin="20,10,0,0"
                    IsEnabled="{Binding Setting.EnableVarspeed}"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [VarspeedReadDurationMs]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioVarspeedReadDurationMs]}"
                        Text="{Binding Setting.VarspeedReadDurationMs}">
                    </TextBox>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [Millisecond]}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="{markup:Translate [Sound]}">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [SoundFolderPath]}" />
                    <TextBox
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioSoundFolderPath]}"
                        Text="{Binding Setting.SoundFolderPath}">
                    </TextBox>
                    <Button
                        Grid.Column="2"
                        Padding="20,2,20,2"
                        cal:Message.Attach="OnSoundFolderPathButtonClick()"
                        ToolTip="{markup:Translate [SettingsToolTipAudioBrowseSounds]}"
                        Content="{markup:Translate [Browser]}" />
                </Grid>

                <CheckBox
                    Margin="0,10,0,0"
                    Content="Allow one sound to be played multiple times at the same time. (require restart program)"
                    ToolTip="{markup:Translate [SettingsToolTipAudioEnableSoundMultiPlay]}"
                    IsChecked="{Binding Setting.EnableSoundMultiPlay}" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [SoundOffsetMs]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioSoundOffsetMs]}"
                        Text="{Binding Setting.SoundOffsetMs}">
                    </TextBox>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [Millisecond]}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="{markup:Translate [Visualizer]}">
            <StackPanel Margin="10">
                <CheckBox Content="{markup:Translate [EnableVisualizerDisplay]}" IsChecked="{Binding PlayerSetting.EnableWaveformDisplay}" ToolTip="{markup:Translate [SettingsToolTipAudioEnableWaveformDisplay]}" />
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding WaveformColorsProperties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5" ToolTip="{markup:Translate [SettingsToolTipAudioWaveformColor]}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name, Converter={StaticResource ResourceKeyToTextConverter}}" />
                                    <Border
                                        Width="25"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding Brush}"
                                        CornerRadius="7" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding ColorString}" />
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Right"
                                    Padding="10,2"
                                    cal:Message.Attach="OnSelectWaveformColor($executionContext)"
                                    ToolTip="{markup:Translate [SettingsToolTipAudioWaveformColor]}"
                                    Content="{markup:Translate [Change]}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [WaveformBodyLineWidth]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioWaveformBodyLineWidth]}"
                        Text="{Binding PlayerSetting.WaveformBodyLineWidth}" />
                    <TextBlock VerticalAlignment="Center" Text="px (1–24)" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [WaveformHoldLineWidth]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioWaveformHoldLineWidth]}"
                        Text="{Binding PlayerSetting.WaveformHoldLineWidth}" />
                    <TextBlock VerticalAlignment="Center" Text="px (1–24)" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [WaveformMarkerLineWidth]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip="{markup:Translate [SettingsToolTipAudioWaveformMarkerLineWidth]}"
                        Text="{Binding PlayerSetting.WaveformMarkerLineWidth}" />
                    <TextBlock VerticalAlignment="Center" Text="px (1–24)" />
                </StackPanel>
                <CheckBox
                    Margin="0,10,0,0"
                    Content="{markup:Translate [EnableWaveformBlockPrerender]}"
                    ToolTip="{markup:Translate [SettingsToolTipAudioEnableWaveformBlockPrerender]}"
                    IsChecked="{Binding PlayerSetting.EnableWaveformBlockPrerender}" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
