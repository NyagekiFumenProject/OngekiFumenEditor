<UserControl
    x:Class="OngekiFumenEditor.Kernel.SettingPages.FumenVisualEditor.Views.FumenVisualEditorGlobalSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="clr-namespace:OngekiFumenEditor.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:OngekiFumenEditor.Properties"
    xmlns:valueconverters="clr-namespace:OngekiFumenEditor.Kernel.SettingPages.FumenVisualEditor.ValueConverters"
    xmlns:vm="clr-namespace:OngekiFumenEditor.Kernel.SettingPages.FumenVisualEditor.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True,
                                     Type=vm:FumenVisualEditorGlobalSettingViewModel}"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Gemini;component/Themes/SettingsToolTips.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <valueconverters:IntToSolidBrush x:Key="IntToSolidBrush" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <GroupBox Margin="5" Header="{markup:Translate [AutoSave]}">
            <StackPanel Margin="10">
                <CheckBox Content="{markup:Translate [EnableAutoSave]}" IsChecked="{Binding Setting.IsEnableAutoSave}" ToolTip="{markup:Translate [SettingsToolTipEditorEnableAutoSave]}" />
                <StackPanel
                    Margin="0,10,0,0"
                    IsEnabled="{Binding Setting.IsEnableAutoSave}"
                    Orientation="Horizontal"
                    ToolTip="{markup:Translate [SettingsToolTipEditorAutoSaveInterval]}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTipService.ShowDuration="60000">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [AutoSaveInterval]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0,5,0"
                        Text="{Binding Setting.AutoSaveTimeInterval}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorAutoSaveInterval]}">
                    </TextBox>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [TimesPerMin]}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="{markup:Translate [UndoRedo]}">
            <StackPanel Margin="10">
                <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding Setting.RecoveryCurrentTimeAfterExecuteAction}" ToolTip="{markup:Translate [SettingsToolTipEditorRecoveryUndoPosition]}">
                    <TextBlock Text="{markup:Translate [RememberUndoPlace]}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox
                    Margin="0,10,0,0"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding Setting.IsEnableUndoActionSavingLimit}"
                    ToolTip="{markup:Translate [SettingsToolTipEditorEnableUndoLimit]}">
                    <TextBlock Text="{markup:Translate [LimitUndoCount]}" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel
                    Margin="0,10,0,0"
                    IsEnabled="{Binding Setting.IsEnableUndoActionSavingLimit}"
                    Orientation="Horizontal"
                    ToolTip="{markup:Translate [SettingsToolTipEditorUndoLimit]}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTipService.ShowDuration="60000">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [SaveMaxCount_Part1]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0,5,0"
                        Text="{Binding Setting.UndoActionSavingLimit}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorUndoLimit]}">
                    </TextBox>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [SaveMaxCount_Part2]}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="{markup:Translate [UserInteraction]}">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [EditorMouseWheelSpeed]}" />
                    <TextBox
                        Grid.Column="1"
                        Width="50"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        Text="{Binding Setting.MouseWheelLength}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorMouseWheelLength]}">
                    </TextBox>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{markup:Translate [EditorMouseWheelSpeed_Unit]}"
                        TextWrapping="Wrap" />
                </Grid>
                <CheckBox
                    Margin="0,10,0,0"
                    Content="{markup:Translate [EnableHorizonScroll]}"
                    IsChecked="{Binding Setting.EnableXOffset}"
                    ToolTip="{markup:Translate [SettingsToolTipEditorEnableHorizontalScroll]}" />
                <CheckBox
                    Margin="0,10,0,0"
                    Content="{markup:Translate [EnableHorizonScrollBarDisplay]}"
                    IsChecked="{Binding Setting.ShowXOffsetScrollBar}"
                    IsEnabled="{Binding Setting.EnableXOffset}"
                    ToolTip="{markup:Translate [SettingsToolTipEditorShowHorizontalScrollBar]}" />
                <CheckBox
                    Margin="0,10,0,0"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding Setting.EnablePlaceObjectBeyondAudioDuration}"
                    ToolTip="{markup:Translate [SettingsToolTipEditorPlaceBeyondAudio]}">
                    <TextBlock Text="{markup:Translate [EnablePlaceObjectBeyondAudioDuration]}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox
                    Margin="0,10,0,0"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding Setting.ReturnStartTimeAfterPause}"
                    ToolTip="{markup:Translate [SettingsToolTipEditorReturnAfterPause]}">
                    <TextBlock Text="{markup:Translate [ReturnStartTimeAfterPause]}" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [EditorOffsetMs]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        Text="{Binding Setting.EditorOffsetMs}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorOffsetMs]}">
                    </TextBox>
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [Millisecond]}" />
                </StackPanel>
                <CheckBox
                    Margin="0,10,0,0"
                    VerticalContentAlignment="Center"
                    Content="{markup:Translate [InjectDefaultClickSE]}"
                    IsChecked="{Binding Setting.InjectDefaultClickSE}"
                    ToolTip="{markup:Translate [SettingsToolTipEditorInjectDefaultClickSE]}" />
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="{markup:Translate [Render]}">
            <StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [HoldBodyWidth]}" />
                    <TextBox
                        x:Name="HoldBodyWidthTextBox"
                        Width="50"
                        Margin="5,0"
                        KeyDown="HoldBodyWidthTextBox_KeyDown"
                        LostKeyboardFocus="HoldBodyWidthTextBox_LostKeyboardFocus"
                        Text="{Binding HoldBodyWidthText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorHoldBodyWidth]}" />
                    <TextBlock VerticalAlignment="Center" Text="px (1–50)" />
                </StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [TextureSizeScale]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Setting.TextureSizeScale}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorTextureSizeScale]}" />
                    <TextBlock VerticalAlignment="Center" Text="× (0.25–3)" />
                </StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [HoldBodyOpacity]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Setting.HoldBodyOpacity}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorHoldBodyOpacity]}" />
                    <TextBlock VerticalAlignment="Center" Text="(0–1)" />
                </StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [LaneLineWidth]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Setting.LaneLineWidth}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorLaneLineWidth]}" />
                    <TextBlock VerticalAlignment="Center" Text="px (1–24)" />
                </StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [WallLaneLineWidth]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Setting.WallLaneLineWidth}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorWallLaneLineWidth]}" />
                    <TextBlock VerticalAlignment="Center" Text="px (1–24)" />
                </StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [AutoPlayFaderLineWidth]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Setting.AutoPlayFaderLineWidth}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorAutoPlayFaderLineWidth]}" />
                    <TextBlock VerticalAlignment="Center" Text="px (1–24)" />
                </StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{markup:Translate [DefaultCurvePrecision]}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Setting.DefaultCurvePrecision}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorDefaultCurvePrecision]}" />
                    <TextBlock VerticalAlignment="Center" Text="(≥0.01)" />
                </StackPanel>
                <StackPanel Margin="10,5,5,5" Orientation="Horizontal">
                    <TextBlock Text="Limit FPS:" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Setting.LimitFPS}"
                        ToolTip="{markup:Translate [SettingsToolTipEditorLimitFPS]}" />
                    <TextBlock x:Name="noLimitText" Text="{markup:Translate [NoLimit]}">
                        <Behaviors:Interaction.Triggers>
                            <Behaviors:DataTrigger
                                Binding="{Binding Setting.LimitFPS}"
                                Comparison="LessThanOrEqual"
                                Value="0">
                                <Behaviors:DataTrigger.Actions>
                                    <Behaviors:ChangePropertyAction
                                        PropertyName="Visibility"
                                        TargetObject="{Binding ElementName=noLimitText}"
                                        Value="Visible" />
                                </Behaviors:DataTrigger.Actions>
                            </Behaviors:DataTrigger>
                            <Behaviors:DataTrigger
                                Binding="{Binding Setting.LimitFPS}"
                                Comparison="GreaterThan"
                                Value="0">
                                <Behaviors:DataTrigger.Actions>
                                    <Behaviors:ChangePropertyAction
                                        PropertyName="Visibility"
                                        TargetObject="{Binding ElementName=noLimitText}"
                                        Value="Hidden" />
                                </Behaviors:DataTrigger.Actions>
                            </Behaviors:DataTrigger>
                        </Behaviors:Interaction.Triggers>
                    </TextBlock>
                </StackPanel>
                <GroupBox Margin="5,0,5,5" Header="{markup:Translate [PreviewMode]}">
                    <StackPanel Margin="10">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{markup:Translate [BellBulletCountOverLimit_Part1]}"
                                TextWrapping="WrapWithOverflow" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="50"
                                    Margin="5,0,2,0"
                                    Text="{Binding Setting.ParallelCountLimit}"
                                    ToolTip="{markup:Translate [SettingsToolTipEditorParallelCountLimit]}">
                                </TextBox>
                                <TextBlock Text="{markup:Translate [BellBulletCountOverLimit_Sep]}">
                                </TextBlock>
                            </StackPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{markup:Translate [BellBulletCountOverLimit_Part2]}"
                                TextWrapping="WrapWithOverflow" />
                        </WrapPanel>
                        <StackPanel Margin="0,10,0,5" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{markup:Translate [BackgroundColor]}" />
                            <Border
                                Width="60"
                                Height="18"
                                Margin="10,0"
                                cal:Message.Attach="[Event MouseDown] = [Action OnSelectBackgroundColor($executionContext)]"
                                Background="{Binding Setting.PlayFieldBackgroundColor, Converter={StaticResource IntToSolidBrush}}"
                                BorderBrush="{Binding Setting.PlayFieldBackgroundColor, Converter={StaticResource IntToSolidBrush}, ConverterParameter=True}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Cursor="Hand"
                                ToolTip="{markup:Translate [SettingsToolTipEditorPlayFieldBackgroundColor]}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTipService.ShowDuration="60000">
                            </Border>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding Setting.EnablePlayFieldDrawing}" ToolTip="{markup:Translate [SettingsToolTipEditorEnablePlayFieldDrawing]}">
                            <TextBlock Text="{markup:Translate [EnablePlayFieldDrawing]}" />
                        </CheckBox>
                        <StackPanel
                            Margin="0,5,0,5"
                            IsEnabled="{Binding Setting.EnablePlayFieldDrawing}"
                            ToolTip="{markup:Translate [SettingsToolTipEditorPlayFieldOptions]}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTipService.ShowDuration="60000">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{markup:Translate [PlayFieldForegroundColor]}" />
                                <Border
                                    Width="60"
                                    Height="18"
                                    Margin="10,0"
                                    cal:Message.Attach="[Event MouseDown] = [Action OnSelectForegroundColor($executionContext)]"
                                    Background="{Binding Setting.PlayFieldForegroundColor, Converter={StaticResource IntToSolidBrush}}"
                                    BorderBrush="{Binding Setting.PlayFieldForegroundColor, Converter={StaticResource IntToSolidBrush}, ConverterParameter=True}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Cursor="Hand"
                                    ToolTip="{markup:Translate [SettingsToolTipEditorPlayFieldForegroundColor]}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTipService.ShowDuration="60000">
                                </Border>
                            </StackPanel>
                            <CheckBox Margin="0,5,0,0" IsChecked="{Binding Setting.HideWallLaneWhenEnablePlayField}" ToolTip="{markup:Translate [SettingsToolTipEditorHideWallLane]}">
                                <TextBlock Text="{markup:Translate [HideWallLaneWhenEnablePlayField]}" />
                            </CheckBox>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding Setting.EnableShowPlayerLocation}" ToolTip="{markup:Translate [SettingsToolTipEditorShowPlayerLocation]}">
                            <TextBlock Text="{markup:Translate [EnableShowPlayerLocation]}" TextWrapping="WrapWithOverflow" />
                        </CheckBox>
                        <CheckBox Margin="0,5,0,0" IsChecked="{Binding Setting.ShowHitObjectEffectInPreviewMode}" ToolTip="{markup:Translate [SettingsToolTipEditorShowHitEffects]}">
                            <TextBlock Text="{markup:Translate [ShowHitObjectEffectInPreviewMode]}" TextWrapping="WrapWithOverflow" />
                        </CheckBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="{markup:Translate [Other]}">
            <StackPanel Margin="10">
                <Button
                    Padding="10,5,10,5"
                    HorizontalAlignment="Left"
                    cal:Message.Attach="ClearRecentOpen()"
                    Content="{markup:Translate [CleanRecentFilesRecords]}"
                    ToolTip="{markup:Translate [SettingsToolTipEditorClearRecentFiles]}" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
