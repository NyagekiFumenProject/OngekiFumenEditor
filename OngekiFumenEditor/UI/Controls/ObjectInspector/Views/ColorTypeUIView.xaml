<UserControl
    x:Class="OngekiFumenEditor.UI.Controls.ObjectInspector.Views.ColorTypeUIView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="clr-namespace:OngekiFumenEditor.UI.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:OngekiFumenEditor.UI.Controls.ObjectInspector.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ColorTypeUIViewModel}"
    mc:Ignorable="d">
    <GroupBox
        Margin="5,0,5,0"
        BorderBrush="DarkGray"
        Foreground="{DynamicResource EnvironmentToolWindowText}"
        Header="{Binding PropertyInfo.DisplayPropertyName}"
        ToolTip="{Binding PropertyInfo.DisplayPropertyTipText}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="24"
                Height="20"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                BorderBrush="DarkGray"
                BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{Binding PreviewColor}" />
                </Border.Background>
            </Border>
            <TextBlock
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource EnvironmentToolWindowText}"
                Text="{Binding ColorText}" />
            <Button
                Grid.Column="2"
                Padding="10,2"
                cal:Message.Attach="OnSelectColor($executionContext)"
                Content="{markup:Translate [ChangeColor]}"
                Foreground="{DynamicResource EnvironmentToolWindowText}" />
        </Grid>
    </GroupBox>
</UserControl>
