<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Link the real analyzer without rebuilding or launching the editor. -->
    <Compile Include="../OngekiFumenEditor/Kernel/Audio/SampleData.cs" Link="Production/SampleData.cs" />
    <Compile Include="../OngekiFumenEditor/Kernel/Audio/SampleInfo.cs" Link="Production/SampleInfo.cs" />
    <Compile Include="../OngekiFumenEditor/Kernel/Audio/Rhythm/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../OngekiFumenEditor/Modules/AudioPlayerToolViewer/Graphics/WaveformDrawing/RhythmCurveTone.cs" Link="Production/RhythmCurveTone.cs" />
    <Compile Include="../OngekiFumenEditor/Modules/AudioPlayerToolViewer/Graphics/WaveformDrawing/RhythmCurveIntensity.cs" Link="Production/RhythmCurveIntensity.cs" />
    <Compile Include="../OngekiFumenEditor.RhythmAnalysisCheck/SyntheticClickTrack.cs" Link="SyntheticClickTrack.cs" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.0" />
  </ItemGroup>
</Project>
